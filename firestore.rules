rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    /// Returns true if the caller is signed in.
    function isAuth() {
      return request.auth != null;
    }

    /// Returns true if the caller owns the document keyed by their UID.
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /// Returns true if the caller is an admin (roles.isAdmin in their user doc).
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('roles', {}).get('isAdmin', false) == true;
    }

    /// Returns true if a group document's memberIds array contains the caller's UID.
    function isGroupMember(groupId) {
      return isAuth() &&
        request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    /// Resolves the signed-in user's borough from the CF-controlled public mirror.
    /// Reads users_public/{uid}.borough — written only by the setUserBorough CF
    /// via Admin SDK; the F-09 affectedKeys rule blocks all client writes of borough
    /// to users/{uid}, so this value cannot be spoofed by the caller.
    /// Returns '' if the doc is missing or the field is absent — fail-closed.
    function writerBorough() {
      return isAuth()
        ? get(/databases/$(database)/documents/users_public/$(request.auth.uid))
            .data.get('borough', '')
        : '';
    }

    /// Returns true when the document's borough field matches the writer's borough.
    /// Case-insensitive. Returns false if either side is empty — fail-closed.
    function boroughMatches(docBorough) {
      return writerBorough() != ''
        && docBorough != ''
        && docBorough.lower() == writerBorough().lower();
    }

    // =========================================================================
    // USERS — PRIVATE DOCUMENT  (F-08 + F-09 hardened)
    // =========================================================================
    // users/{uid} holds sensitive fields: phone, email, postcode, children,
    // fcmToken, stripeCustomerId, roles, tier, isFoundingMember, isPhoneVerified,
    // borough/ward/wardCode/districtCode/region (geo).
    //
    // F-08: read locked to owner + admin — closes cross-user child-data harvest.
    //       Public display fields (name, photoUrl, borough, isOnline, etc.) are
    //       served from users_public/{uid} instead (see block below).
    //
    // F-09: update has an affectedKeys blocklist that prevents privilege escalation
    //       (roles.isAdmin self-grant) and borough-spoofing (borough self-write).
    //       Borough writes are CF-only via setUserBorough + Admin SDK.
    //
    // Borough-write-after-lock resolution: setUserBorough callable writes borough
    //   + geo fields to users/{uid} via Admin SDK (bypasses rules). Client owner
    //   writes of these fields are blocked by the affectedKeys guard below.
    // =========================================================================
    match /users/{userId} {
      // F-08: owner or admin only — no cross-user reads of sensitive data.
      allow read: if isOwner(userId) || isAdmin();

      // A user may only create their own profile document.
      // AGE-1-R1 (server enforcement — bypass-proof, fail-closed, full DOB):
      //   All three fields must be present as ints (missing any field → rejected).
      //   Age is computed precisely, mirroring client _ageFromDob():
      //     year diff > 18              → always old enough
      //     year diff == 18, month/day  → birthday must have already occurred today
      //     year diff < 18              → always too young
      //   request.time.{year,month,day} are Firestore server values — unspoofable.
      //   Replaces AGE-1 year-only rule which was permissive by up to ~11 months.
      allow create: if isOwner(userId)
        && request.resource.data.birthYear  is int
        && request.resource.data.birthMonth is int
        && request.resource.data.birthDay   is int
        && (
             (request.time.year - request.resource.data.birthYear > 18)
             || (request.time.year - request.resource.data.birthYear == 18
                 && (request.time.month > request.resource.data.birthMonth
                     || (request.time.month == request.resource.data.birthMonth
                         && request.time.day >= request.resource.data.birthDay)))
           );

      // F-09: owner update is blocked if any blocklisted field is touched.
      //   Blocklist (16 fields): roles, tier, stripeCustomerId, isFoundingMember,
      //   isPhoneVerified, borough, postcode, ward, wardCode, districtCode, region,
      //   businessVerified, verificationMethod, verifiedBusinessName, verificationData,
      //   businessSelfDeclared.
      //   fcmToken is intentionally NOT in the blocklist — self-writing own token
      //   is harmless; blocking it would break push registration on every login.
      //   Admin updates bypass the blocklist (moderation / badge grants).
      allow update: if
        isAdmin()
        ||
        (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['roles', 'tier', 'stripeCustomerId', 'isFoundingMember',
                       'isPhoneVerified', 'borough', 'postcode', 'ward',
                       'wardCode', 'districtCode', 'region',
                       'businessVerified', 'verificationMethod',
                       'verifiedBusinessName', 'verificationData',
                       'businessSelfDeclared'])
        );

      // Accounts are soft-deleted (isDeleted flag) — no hard deletes from client.
      // Actual deletion is via the Admin SDK in the deleteAccount cloud function.
      allow delete: if false;

      // ── Sub-collections (ownership unchanged) ────────────────────────────

      // Saved listings mirror: fast lookup for the Saved tab.
      match /savedListings/{listingId} {
        allow read, write: if isOwner(userId);
      }

      // Notification preferences synced from the app.
      match /notifPrefs/{docId} {
        allow read, write: if isOwner(userId);
      }

      // SEND navigator deadlines: users/{uid}/deadlines/{docId}
      // Written by SendNavigatorService._persistDeadlinesToFirestore().
      // Only the owning user may read or write their own deadline docs.
      match /deadlines/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Block list: users/{uid}/blocks/{blockedUid}
      // Written by BlockService._writeToFirestore().
      // Doc ID == blocked user's UID. Only the owner may read or modify.
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      // Saved marketplace items: users/{uid}/saved_items/{listingId}
      // Written by FirestoreService.toggleSavedItem(). Schema: { listingId, savedAt }.
      // Ownership is structural (path) — no userId field in the doc.
      // F-13: subcollection rule was missing; top-level saved_items rule at line ~516
      // covered the wrong path, leaving every user-facing op default-denied.
      match /saved_items/{listingId} {
        allow read, write: if isOwner(userId);
      }

      // Group invitations sent TO this user: users/{uid}/invitations/{invId}
      // Written by InvitationService.sendInvitations() on the inviter's device.
      // The invited user can read and update (accept/decline); only the
      // recipient may delete their own invite.
      //
      // INVITE-RULE-1: create is hardened — was open isAuth() (any user could
      // forge an invite with a spoofed invitedByName/invitedById). Now requires:
      //   (a) invitedById == auth.uid — stamps the REAL sender uid; kills
      //       impersonation of a trusted name. InvitationService.sendInvitations
      //       already writes invitedById = inviterId (the caller's uid), so all
      //       legitimate invites comply with no client change needed.
      //   (b) inviter in groups/{groupId}.memberIds — you can only invite to a
      //       group you are actually a member of (mirrors M3 /notify-group gate).
      //       invite doc carries groupId at top level (confirmed: GroupInvitation
      //       model writes 'groupId': groupId and 'invitedById': invitedById).
      //       Fail-closed: missing/malformed groupId → get() returns a doc with
      //       no memberIds → 'in' expression → false → denied.
      match /invitations/{invitationId} {
        allow read, update: if isOwner(userId);
        allow create: if isAuth()
          && request.resource.data.invitedById == request.auth.uid
          && request.auth.uid in
               get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                 .data.memberIds;
        allow delete: if isOwner(userId);
      }
    }

    // =========================================================================
    // USERS — PUBLIC MIRROR  (CF-controlled, F-08 safe read surface)
    // =========================================================================
    // users_public/{uid} is a read-only mirror of the 10 public fields from
    // users/{uid}: name, photoUrl, parentType, borough, isOnline, stagesOfLife,
    // ward, wardCode, districtCode, region.
    //
    // Written exclusively by the syncPublicProfile Cloud Function (Admin SDK).
    // Client writes are categorically denied — the mirror cannot be poisoned.
    // borough here is always CF-controlled (set by setUserBorough callable),
    // so writerBorough() reading from this collection closes the borough-spoof.
    // =========================================================================
    match /users_public/{userId} {
      // Any authenticated user may read the public mirror (group member lists,
      // DM headers, borough member picker — all the reads F-08 previously blocked).
      allow read: if isAuth();

      // All client writes denied — Admin SDK / CF only.
      allow write: if false;
    }

    // =========================================================================
    // SUBSCRIPTIONS  (one doc per user: subscriptions/{userId})
    // Written exclusively by the backend (Stripe webhook handler via Admin SDK)
    // and the seedWelcomeSubscription Cloud Function (Admin SDK).
    // Flutter reads to determine the user's tier on app start.
    //
    // Entitlements are SERVER-AUTHORITATIVE — the client NEVER writes this
    // collection.  Welcome-tier seeding is handled by the
    // seedWelcomeSubscription CF (users/{uid} Firestore onCreate trigger).
    // =========================================================================
    match /subscriptions/{userId} {
      // Users read their own subscription doc only.
      allow read: if isOwner(userId);

      // Client never writes subscription docs — the Railway backend (Stripe
      // webhook) and the seedWelcomeSubscription CF do via Admin SDK (which
      // bypasses these rules).  Deny all client writes to prevent tier
      // manipulation.
      allow write: if false;
    }

    // =========================================================================
    // GROUPS
    // =========================================================================
    match /groups/{groupId} {
      // BOROUGH-READ-1: read locked to caller's own borough + admin escape.
      // boroughMatches checks resource.data.borough against users_public/{uid}.borough
      // (CF-controlled, cannot be spoofed by the client).
      // Single-doc gets (getGroup, groupStream) are also borough-gated — a crafted
      // client cannot read another borough's group by doc ID.
      // Composite index required: groups — privacy ASC + borough ASC
      //   (needed by getDiscoverGroups Part 1 query; Firestore logs console link if missing).
      allow read: if isAuth() && (boroughMatches(resource.data.get('borough', '')) || isAdmin());

      // Borough-scoped create: backfill complete — read canonical 'borough' only.
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid
        && boroughMatches(request.resource.data.get('borough', ''));

      // Members may update non-sensitive group fields (e.g. lastMessage).
      // The creator/admin may update everything (borough already stamped at create).
      // F-07: self-join is now scoped to PUBLIC groups only. Private/group-privacy
      // groups require an invite — the accept path (_handleAccept) writes memberIds
      // server-side and is covered by branch 1 (creator) or branch 2 (existing member
      // re-add after leave/rejoin). Direct self-join into private groups is blocked.
      // Borough-scoped update: full-field updates (creator path) must still match
      // the doc's existing borough.
      allow update: if isAuth() && (
        // Branch 1 — Group creator has full update rights; borough must match existing doc.
        // Backfill complete — read canonical 'borough' only.
        (
          resource.data.creatorUid == request.auth.uid
          && boroughMatches(resource.data.get('borough', ''))
        )
        ||
        // Branch 2 — Any existing member may update limited activity fields.
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
              // GROUPS-MEMBERIDS-1: removed 'memberIds' — membership changes
              // must go through Branch 3 (self-join) or Branch 1 (creator) only.
              .hasOnly(['lastMessage', 'lastMessageTime', 'lastActiveAt',
                        'memberCount', 'lastSenderName'])
        )
        ||
        // Branch 3 (F-07) — Self-join: caller adds ONLY their own UID to memberIds.
        // Requires group privacy == 'public' (default when field absent).
        // hasAll ensures no existing member is removed.
        // hasOnly(concat([uid])) ensures the caller's UID is the sole new element —
        // no other UIDs may be injected, not even alongside the caller's own.
        (
          resource.data.get('privacy', 'public') == 'public'
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasOnly(
               resource.data.memberIds.concat([request.auth.uid]))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberIds', 'members', 'memberCount', 'updatedAt'])
        )
      );

      // Only the creator may delete their group.
      allow delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;

      // -----------------------------------------------------------------------
      // MEMBER ACTIVITY subcollection  (F-02 hardened)
      // -----------------------------------------------------------------------
      // groups/{groupId}/memberActivity/{memberUid}
      //
      // F-02: the previous rule was match /memberActivity/{docId} at top-level
      //   — a root collection that does not exist. The actual subcollection at
      //   groups/{groupId}/memberActivity/{uid} had NO rule, meaning all client
      //   writes were silently denied by Firestore's default-deny.
      //
      //   Legitimate write paths (all write-own-doc only):
      //     • create_group_screen: creator writes own activity doc at group create
      //     • group_chat_screen._incrementMemberActivity: increments own messageCount
      //     • invitation_service.joinPublicGroup: writes own joinedAt on first join
      //
      //   Legitimate read paths (cross-member reads required):
      //     • group_details_screen: reads ALL members' activity ordered by messageCount
      //       to auto-promote the most active member when a sole admin leaves
      //     • manage_admins_screen: same query for sole-admin demotion flow
      //
      // Fix:
      //   read  — any group member may read any memberActivity doc in their group
      //   write — caller may only write the doc keyed to their own UID (docId ==
      //           request.auth.uid) AND must be an existing group member
      //
      // isGroupMember() does a get() on groups/{groupId}.memberIds. The group doc
      // always pre-exists before memberActivity is written (group is created first,
      // member joins first). Fail-closed on non-member write is correct posture.
      // -----------------------------------------------------------------------
      match /memberActivity/{memberUid} {
        allow read: if isGroupMember(groupId);
        allow write: if isGroupMember(groupId)
          && memberUid == request.auth.uid;
      }
    }

    // =========================================================================
    // GROUP MESSAGES  (F-03 + F-04 hardened)
    // =========================================================================
    // group_messages is a flat collection; each doc carries a groupId field
    // that links it to its parent groups/{groupId} document.
    //
    // F-03: read was allow read: if isAuth() — any authenticated user could
    //   query all group messages across ALL groups and harvest media URLs
    //   (imageUrl, audioUrl, documentUrl) with permanent bypass tokens.
    //   Fix: read scoped to groups/{groupId}.memberIds via firestore.get().
    //
    // F-04: create had no membership check — any authenticated user could
    //   inject messages into any group, spoofing any senderId.
    //   Fix: create requires caller is in memberIds AND senderId == caller uid.
    //
    // GDPR side-effect (flagged, not blocked): the client-side GDPR delete
    //   path in firebase_auth_service.dart queries group_messages by senderId
    //   using the client SDK. After F-03, that query will fail for groups the
    //   user has already left (membership check blocks the read). The query
    //   is wrapped in a silent catch and fails non-fatally, but messages in
    //   left groups will not be deleted by the client path. The correct fix is
    //   a CF-based Admin SDK deletion sweep — tracked as a follow-on task,
    //   separate from this security stream.
    //
    // groupId field presence: confirmed present on all sendGroupMessage() writes
    //   (firestore_service.dart line 361). All active write paths go through
    //   sendGroupMessage(). System-message paths also write groupId (confirmed).
    //   Any legacy doc lacking groupId fails-closed (read denied) — acceptable
    //   since the app only displays messages for groups the user is currently
    //   in (groupMessagesStream always queries .where('groupId', isEqualTo:...)).
    // =========================================================================
    match /group_messages/{messageId} {
      // F-03: only members of the message's group can read it.
      // resource.data.groupId is always present on active write paths.
      // Fail-closed: missing groupId → get() targets groups/null → doc missing
      // → memberIds absent → in operator → false → denied. Correct posture.
      allow read: if isAuth()
        && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(resource.data.groupId))
              .data.memberIds;

      // F-04: caller must be a member of the target group AND must not
      // impersonate another user's senderId.
      // request.resource.data.groupId is the groupId the client intends to post to.
      allow create: if isAuth()
        && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
              .data.memberIds
        && request.resource.data.senderId == request.auth.uid;

      // Message author may update their own message (edit text, reactions, etc.).
      // Any GROUP MEMBER may update reactions/reactionUsers/replies/replyCount —
      // scoped to membership for consistency with the F-03 read lock.
      // (Previously "any auth user" — tightened here because a non-member who
      // guesses a doc ID should not be able to react to a private group message.)
      allow update: if isAuth()
        && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(resource.data.groupId))
              .data.memberIds
        && (
          resource.data.senderId == request.auth.uid
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'reactionUsers', 'updatedAt',
                      'replies', 'replyCount'])
        );

      // Only the sender may soft-delete (unsend) their own message.
      // Hard deletes are blocked — use isDeleted flag instead.
      allow delete: if isAuth()
        && resource.data.senderId == request.auth.uid;
    }

    // =========================================================================
    // DIRECT MESSAGES (conversations + messages)
    // =========================================================================

    // Conversation metadata document.
    match /conversations/{conversationId} {
      // Only participants in the conversation can read/write it.
      // Field is 'participants' (array) — matches RealtimeDMService schema.
      allow read: if isAuth()
        && request.auth.uid in resource.data.participants;

      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants;

      // DM-PARTICIPANTS-1: a participant may update conversation metadata but
      // may NOT rewrite the participants array (would let them evict the other
      // party or inject a third). Membership is fixed at create.
      // Verified safe: realtime_dm_service conversation update paths write only
      // lastMessage/lastSenderId/lastSenderName/lastMessageAt/participantAvatars/unreadCount.
      allow update: if isAuth()
        && request.auth.uid in resource.data.participants
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['participants']);

      // Conversations are never deleted from the client.
      allow delete: if false;

      // ── Messages subcollection ────────────────────────────────────────────
      match /messages/{messageId} {
        // Only participants in the parent conversation can read messages.
        // Field is 'participants' (array) — matches RealtimeDMService schema.
        allow read: if isAuth()
          && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participants;

        // Either participant may send; senderId must match their UID AND
        // the sender must be a participant in the parent conversation.
        // (DM-INJECT-1: previously any auth user could inject into any conversation by ID.)
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participants;

        // Sender may update their own message (reactions, status, unsend flag).
        // Either participant may update reactions.
        allow update: if isAuth() && (
          resource.data.senderId == request.auth.uid
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'status', 'updatedAt'])
        );

        // Sender may delete (unsend) their own message only.
        allow delete: if isAuth()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // F-06: direct_messages is a dead collection.
    // RealtimeDMService writes exclusively to conversations/{id}/messages.
    // sendDirectMessage() / dmMessagesStream() in FirestoreService have zero
    // call sites — orphaned methods, never invoked.
    // GDPR sweep (deleteAccount step 4) was explicitly removed — no sweep needed.
    // create/update locked to if false; read + delete retained for legacy data.
    match /direct_messages/{messageId} {
      // Legacy read: participant in the associated conversation may read.
      allow read: if isAuth()
        && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
              .data.participants;

      // F-06: No active write path — collection is dead for new writes.
      allow create: if false;
      allow update: if false;

      // Legacy delete: sender may remove their own old messages.
      allow delete: if isAuth()
        && resource.data.senderId == request.auth.uid;
    }

    // =========================================================================
    // EVENTS / MEETUPS
    // =========================================================================
    // Events are UK-wide by design — no borough scoping.
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.creatorUid == request.auth.uid
        ||
        // EVENT-COUNT-1: narrow RSVP branch.
        // Events do NOT use an attendeeIds array — RSVP state is tracked in
        // user_rsvps/{uid}/meetups/{eventId} (owner-only writes, separate rule).
        // EventService.toggleGoing() calls saveRsvp() which writes to user_rsvps
        // only — it does NOT update the events doc at all. The old
        // hasOnly(['attendeeCount','rsvpCount','updatedAt']) branch was therefore
        // a dead write path: no client ever triggered it.
        // Locked to false to close the forged-count surface.
        // attendeeCount on events docs is set at create-time only (read-only after).
        false
      );
      allow delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
    }

    // Borough-scoped: create and full-field updates require borough match.
    match /meetups/{meetupId} {
      // BOROUGH-READ-1: read locked to caller's own borough + admin escape.
      // getMeetups (Part 1) already sends .where('borough', isEqualTo: borough)
      // so list queries satisfy this rule automatically.
      allow read: if isAuth() && (boroughMatches(resource.data.get('borough', '')) || isAdmin());
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid
        && boroughMatches(request.resource.data.get('borough', ''));
      allow update: if isAuth() && (
        // Creator full-update path: borough must match existing doc.
        (
          resource.data.creatorUid == request.auth.uid
          && boroughMatches(resource.data.get('borough', ''))
        )
        ||
        // EVENT-COUNT-1: own-uid-only RSVP branch.
        // Replaces the open hasOnly(['attendeeCount','going']) branch which allowed
        // any auth user to forge any count. attendeeCount is no longer client-written
        // (removed from rsvpMeetup() in firestore_service.dart); count is derived
        // from attendeeIds.length at read time.
        //
        // Constraints: only attendeeIds/attendeeNames/updatedAt may change, AND
        // the attendeeIds change must be exactly ±1 entry equal to the caller's
        // own uid (no injecting other uids, no bulk changes).
        //
        // Add path: uid not in old list, uid in new list, new list has all old
        //   entries + exactly uid → size increases by 1.
        // Remove path: uid in old list, uid not in new list, old list has all
        //   new entries + exactly uid → size decreases by 1.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['attendeeIds', 'attendeeNames', 'updatedAt'])
          && (
            // Add: caller adds only their own uid
            (
              !resource.data.attendeeIds.hasAll([request.auth.uid])
              && request.resource.data.attendeeIds.hasAll([request.auth.uid])
              && request.resource.data.attendeeIds.hasAll(resource.data.attendeeIds)
              && resource.data.attendeeIds.size() + 1 == request.resource.data.attendeeIds.size()
            )
            ||
            // Remove: caller removes only their own uid
            (
              resource.data.attendeeIds.hasAll([request.auth.uid])
              && !request.resource.data.attendeeIds.hasAll([request.auth.uid])
              && resource.data.attendeeIds.hasAll(request.resource.data.attendeeIds)
              && resource.data.attendeeIds.size() - 1 == request.resource.data.attendeeIds.size()
            )
          )
        )
      );
      allow delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
    }

    // RSVP records: user_rsvps/{uid}/meetups/{meetupId}
    match /user_rsvps/{uid}/{type}/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // RSVPS  (top-level collection — legacy/parallel to user_rsvps)
    // Used by meetup RSVP flow and cleared on account deletion.
    // =========================================================================
    match /rsvps/{rsvpId} {
      // Users can read and write their own RSVPs only.
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      // Users may delete their own RSVPs (cancel RSVP flow).
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      // F-01: Recipient reads their own notifications only.
      // Field is 'userId' (not 'recipientId') — matches _write() schema.
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      // F-01: Client cross-user writes are legitimate (A writes notif for B).
      // Guard: senderId must be the writing user (no identity spoofing).
      // Schema: keys must be within the known notification schema.
      // Type allowlist intentionally omitted — senderId + schema constraints
      // are sufficient; hardcoding types would break silently when new
      // notification types ship (methods already exist but not yet wired).
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'userId', 'senderId', 'type', 'title', 'body',
             'read', 'data', 'senderName', 'senderPhotoUrl',
             'imageUrl', 'createdAt'
           ]);

      // F-01: Recipient may mark their own notification read only.
      // Field is 'read' (not 'isRead'/'readAt') — matches _write() schema.
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);

      // Notifications are never hard-deleted from client.
      allow delete: if false;
    }

    // Notification queue (backend-only write, client read-only).
    match /notifications_queue/{docId} {
      allow read: if isAuth()
        && resource.data.recipientId == request.auth.uid;
      allow write: if false; // Backend Admin SDK only
    }

    // =========================================================================
    // SAVED ITEMS  (top-level — dead collection, F-13)
    // =========================================================================
    // F-13: top-level saved_items has no live read/write path — all data lives at
    // users/{uid}/saved_items/{listingId} (subcollection rule above).
    // The old rule checked resource.data.userId but the doc schema has no userId
    // field (only listingId + savedAt), so the read/update arms were always moot.
    // Locked entirely.
    match /saved_items/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // ENDORSEMENTS  (top-level collection)
    // =========================================================================
    match /endorsements/{endorsementId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.endorserUid == request.auth.uid;
      // Endorsements are immutable once created.
      allow update: if false;
      allow delete: if isAuth()
        && resource.data.endorserUid == request.auth.uid;
    }

    // =========================================================================
    // COMMUNITY WISDOM / CROWDSOURCED TIPS  (FLYWHEEL-2 hardened)
    // =========================================================================
    // Publishing pipeline: pendingReview → admin approves → published.
    // Authors can create and edit articles but can NEVER self-publish — the
    // status field is moderator-controlled only (Admin SDK / isAdmin() branch).
    // isAdmin() reads users/{uid}.roles.isAdmin (see helper above).
    match /community_wisdom/{docId} {
      allow read: if isAuth();

      // FLYWHEEL-2: authors may create articles but NEVER publish them directly.
      // A new article must start in review (status 'pendingReview') — publishing
      // is an admin-only status transition below. isAdmin() reads users/{uid}.roles.isAdmin.
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.get('status', 'pendingReview') == 'pendingReview';

      allow update: if isAuth() && (
        // Branch 1 — Admin (moderator) may change anything, incl. status transitions
        // (approve → 'published', reject → 'rejected') and consentGranted.
        isAdmin()
        ||
        // Branch 2 — Author may edit their OWN article's CONTENT, but may NOT touch
        // status or consentGranted (those are moderator-controlled). The affectedKeys
        // exclusion is the enforcement: if the diff touches status/consentGranted, deny.
        (
          resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status', 'consentGranted'])
        )
        ||
        // Branch 3 — Any authenticated user may upvote, but only ±1 (no forged counts).
        // (WISDOM-UPVOTE-1)
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvotes', 'updatedAt'])
          && (request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1
              || request.resource.data.upvotes == resource.data.get('upvotes', 0) - 1)
        )
      );

      allow delete: if isAuth()
        && resource.data.authorUid == request.auth.uid;
    }

    // Upvote records for community_wisdom.
    match /upvotes/{docId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // =========================================================================
    // POLLS  (group polls created from group chat)
    // =========================================================================
    match /polls/{pollId} {
      // Any auth user can read polls (needed for group chat embed).
      allow read: if isAuth();

      // Any auth user can create a poll; createdByUid must match their UID.
      allow create: if isAuth()
        && request.resource.data.createdByUid == request.auth.uid;

      // POLL-VOTE-1: hardened vote-integrity update rule.
      //
      // Branch 1 — creator retains full update rights (close poll, edit, soft-delete).
      //
      // Branch 2 — voter path, three integrity constraints:
      //   (a) group-membership gate: caller must be a member of the poll's group.
      //       Uses get() on groups/{groupId}.memberIds — groupId is a top-level
      //       field on the poll doc (confirmed: createPoll writes 'groupId' at root).
      //   (b) field-scope: only options/voters/updatedAt may change (same as before).
      //   (c) voters-own-key-only: the voters MAP diff may only touch the caller's
      //       own UID key — prevents one member overwriting another's vote entry.
      //       voters is a map keyed by UID → List<optionId> (confirmed from
      //       submitPollVote schema); .diff().affectedKeys() operates on map keys,
      //       so hasOnly([request.auth.uid]) is the correct form for a map.
      //   (d) no-vote-after-close: if closesAt is set and is in the past, deny.
      //       closesAt is a Timestamp or null at the top level of the poll doc.
      //
      // Accepted residual (POLL-VOTE-1-R1): options vote-count exactness is NOT
      // fully enforced. Branch 2 guarantees only a group member votes and only
      // their own voters entry changes; a member could still mis-increment option
      // tallies for their own vote. Full enforcement requires deriving counts from
      // the voters map server-side (Cloud Function on poll write) — tracked as an
      // optional follow-up, NOT built here.
      allow update: if isAuth() && (
        // Branch 1 — creator full rights
        resource.data.createdByUid == request.auth.uid
        ||
        // Branch 2 — constrained voter path
        (
          // (a) caller must be a member of the poll's group
          request.auth.uid in
            get(/databases/$(database)/documents/groups/$(resource.data.groupId))
              .data.memberIds
          // (b) only options/voters/updatedAt may change
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['options', 'voters', 'updatedAt'])
          // (c) voters map diff touches only the caller's own UID key
          && request.resource.data.voters.diff(resource.data.voters)
               .affectedKeys().hasOnly([request.auth.uid])
          // (d) no voting after closesAt (if set)
          && (resource.data.get('closesAt', null) == null
              || request.time < resource.data.closesAt)
        )
      );

      // Only the creator may delete their poll.
      allow delete: if isAuth()
        && resource.data.createdByUid == request.auth.uid;
    }

    // =========================================================================
    // BOROUGH ANNOUNCEMENTS  (noticeboard posts)
    // =========================================================================
    match /borough_announcements/{announcementId} {
      // BOROUGH-READ-1: read locked to caller's own borough + admin escape.
      // NOTE: the Firestore field is 'boroughId' (not 'borough') — confirmed from
      // Announcement.toFirestore() which writes 'boroughId': boroughId.
      // The existing .where('boroughId', isEqualTo: borough) query in
      // AnnouncementService already constrains list reads correctly.
      allow read: if isAuth() && (boroughMatches(resource.data.get('boroughId', '')) || isAdmin());

      // Any auth user may post; authorId must match their UID.
      allow create: if isAuth()
        && request.resource.data.authorId == request.auth.uid;

      // The author may update their own post (edits, likes, comments).
      // Any auth user may update reaction/like counters and commentCount only.
      // F-11: removed 'commentsList' (comments now in subcollection);
      //        added 'commentCount' so the increment from addComment() is permitted.
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid
        ||
        // ANNOUNCE-COUNTER-1: likeCount may only move ±1-or-unchanged;
        // likedBy may only add or remove the caller's own uid (self-only diff);
        // commentCount ±1 for addComment() increment.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likeCount', 'commentCount', 'updatedAt'])
          && (request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) + 1
              || request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) - 1
              || request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0))
          && (
               // likedBy: caller adds only their own uid
               (request.resource.data.get('likedBy', []).hasAll(resource.data.get('likedBy', []))
                && request.resource.data.get('likedBy', []).hasOnly(
                     resource.data.get('likedBy', []).concat([request.auth.uid])))
               ||
               // likedBy: caller removes only their own uid
               (resource.data.get('likedBy', []).hasAll(request.resource.data.get('likedBy', []))
                && resource.data.get('likedBy', []).hasOnly(
                     request.resource.data.get('likedBy', []).concat([request.auth.uid])))
               ||
               // likedBy unchanged (commentCount-only update)
               request.resource.data.get('likedBy', []) == resource.data.get('likedBy', [])
             )
        )
      );

      // Only the author may delete their own post.
      allow delete: if isAuth()
        && resource.data.authorId == request.auth.uid;

      // ── F-11: Comments subcollection ─────────────────────────────────────
      // Each comment is its own document with authorId enforced at write time.
      // Impersonation fix: rule requires authorId == request.auth.uid on create.
      match /comments/{commentId} {
        // Any authenticated user can read comments.
        allow read: if isAuth();

        // Create: caller must set authorId to their own uid (kills impersonation).
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid;

        // Update: comment author may edit; any auth user may update likes/likedBy only.
        allow update: if isAuth() && (
          resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes', 'likedBy'])
        );

        // Delete: comment author only.
        allow delete: if isAuth()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // =========================================================================
    // FEEDBACK  (in-app feedback submissions)
    // =========================================================================
    match /feedback/{docId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // DEADLINES  (top-level — dead collection, F-12)
    // =========================================================================
    // F-12: This top-level collection has no live write or read path.
    // All real SEND deadline data lives at users/{uid}/deadlines/{docId}
    // (see subcollection rule in the /users/{userId} block above).
    // SendDeadline.toJson() does not write a 'uid' field, so the old rule's
    // uid-scoping would have denied all writes anyway. Locked entirely.
    match /deadlines/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // USER RECOMMENDATIONS  (algorithmic suggestions)
    // =========================================================================
    match /userRecommendations/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Backend Admin SDK only
    }

    // =========================================================================
    // OFFERS  (top-level, used by marketplace offer flow)
    // =========================================================================
    match /offers/{offerId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
      );
      allow delete: if false;
    }

    // =========================================================================
    // LOCAL SERVICES
    // =========================================================================
    // Borough-scoped: create and owner-update paths require borough match.
    match /local_services/{listingId} {
      // BOROUGH-READ-1: read locked to caller's own borough + admin escape.
      allow read: if isAuth() && (boroughMatches(resource.data.get('borough', '')) || isAdmin());

      // LSS-1: a client may create a listing but NEVER a pre-verified one.
      // isVerified/verificationTier are set ONLY by the verifyBusiness CF (Admin SDK).
      allow create: if isAuth()
        && request.resource.data.createdByUid == request.auth.uid
        && boroughMatches(request.resource.data.get('borough', ''))
        && request.resource.data.get('verificationTier', 'none') == 'none'
        && request.resource.data.get('isVerified', false) == false;

      // The listing owner may update any field (borough must still match).
      // Any authenticated user may increment/update the aggregate fields
      // that are written by the endorsement flow (endorsementCount,
      // communityRating, ratingCount, updatedAt).
      // Without this, batch.update() in endorseListing() is rejected for
      // non-owners and throws a permission-denied error caught as
      // "Something went wrong".
      allow update: if isAuth() && (
        // Owner full-update: borough must match existing doc.
        (
          resource.data.createdByUid == request.auth.uid
          && boroughMatches(resource.data.get('borough', ''))
        )
        ||
        // Endorsement-aggregate updates by ANY auth user (cross-user endorsement flow).
        // verificationTier was REMOVED from this allowlist (LSS-1): verification status
        // must never be writable by a non-owner/endorser. It is CF/Admin-SDK only.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['endorsementCount', 'communityRating', 'ratingCount', 'updatedAt'])
      );

      // Only the lister may delete their listing.
      allow delete: if isAuth()
        && resource.data.createdByUid == request.auth.uid;

      // ── Endorsements sub-collection ──────────────────────────────────
      // Document ID equals the endorser's UID (one endorsement per user).
      match /endorsements/{endorsementId} {
        // Any auth user can read endorsements (shown on listing detail page).
        allow read: if isAuth();

        // An auth user may create an endorsement only for their own UID,
        // only if they are not the listing owner.
        allow create: if isAuth()
          && endorsementId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/local_services/$(listingId)).data.createdByUid
              != request.auth.uid;

        // The endorser may delete (retract) their own endorsement.
        allow delete: if isAuth()
          && endorsementId == request.auth.uid;

        // The listing owner may add/update an owner reply only.
        allow update: if isAuth()
          && get(/databases/$(database)/documents/local_services/$(listingId)).data.createdByUid
              == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerReply', 'ownerRepliedAt']);
      }
    }

    // =========================================================================
    // REPORTS  (existing — unchanged)
    // =========================================================================
    match /reports/{reportId} {
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.reporterId == request.auth.uid
        || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // GDPR EXPORTS  (existing — unchanged)
    // =========================================================================
    match /gdpr_exports/{docId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // USER CONSENTS  (LAYER-15-CONSENT-AUDIT-1)
    //
    // Durable consent record written atomically with the user account at
    // onboarding completion (_createUserProfile atomic batch, firebase_auth_service.dart).
    //
    // Schema: { userId, dataProcessing (bool), marketing (bool),
    //           policyVersion (string), consentedAt (Timestamp),
    //           recordedAt (Timestamp) }
    //
    // Immutability: consent records are an AUDIT TRAIL — update and delete are
    // categorically denied for client writes.  Re-consent (e.g. policy bump)
    // is handled server-side; a new version record is appended rather than
    // overwriting this one.
    //
    // Erasure posture: intentionally EXCLUDED from deleteUserData sweep.
    // Deleting the record would destroy the proof of lawful basis (GDPR Art. 6(a)).
    // The record contains only consent metadata (no sensitive PII beyond the uid
    // link) — retaining it is consistent with the gdpr_erasure_jobs HARD-LOCK
    // pattern established in Layer 3.
    // =========================================================================
    match /user_consents/{userId} {
      // Owner may read their own consent record (e.g. settings screen "what data").
      allow read: if isOwner(userId);

      // Owner creates their own consent record at onboarding.
      // userId field in the doc must match the authenticated uid (anti-spoof).
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid;

      // Consent records are immutable — no client update or delete.
      allow update, delete: if false;
    }

    // =========================================================================
    // MARKETPLACE
    // Borough-scoped: create and seller-update paths require borough match.
    // =========================================================================
    match /marketplace/{itemId} {
      // BOROUGH-READ-1: read locked to caller's own borough + admin escape.
      // Composite index required: marketplace — status ASC + borough ASC
      //   (needed by getMarketplaceListings Part 1 query; Firestore logs console link if missing).
      allow read: if isAuth() && (boroughMatches(resource.data.get('borough', '')) || isAdmin());
      // Seller's resolved borough must match the doc's borough field.
      // Backfill complete — read canonical 'borough' only.
      allow create: if isAuth()
        && request.resource.data.sellerId == request.auth.uid
        && boroughMatches(request.resource.data.get('borough', ''));
      allow update: if isAuth() && (
        // Seller full-update: borough must match existing doc's borough field.
        // Backfill complete — read canonical 'borough' only.
        (
          resource.data.sellerId == request.auth.uid
          && boroughMatches(resource.data.get('borough', ''))
        )
        ||
        // Narrow aggregate-counter updates require no borough check.
        // MARKET-COUNTER-1 (accepted LOW): viewCount/offerCount/favouriteCount are
        // cross-user vanity counters, field-locked (cannot inject other fields or
        // touch borough/price/seller). Exact tally integrity is a server-derive task
        // (CF), tracked separately — consistent with partner_analytics F-05 posture.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount', 'offerCount', 'favouriteCount', 'updatedAt'])
      );
      allow delete: if isAuth()
        && resource.data.sellerId == request.auth.uid;
    }

    // =========================================================================
    // BOROUGH FEED — PROMOTED CARDS
    // Reads locked to the user's own borough (+ admin cross-borough access).
    // Writes (create/update/delete) require the path borough to match the writer.
    // =========================================================================
    match /borough_feed/{boroughKey}/promoted/{promotedId} {
      // Users may only read cards in their own borough.
      // isAdmin() grants cross-borough read for admin/analytics tooling.
      allow read: if isAuth()
        && (
          (
            boroughKey.lower() == writerBorough().lower()
            && writerBorough() != ''
          )
          || isAdmin()
        );
      // FEED-1: promoted cards require a real Partner entitlement (custom claim
      // request.auth.token.partner, set ONLY by the Stripe webhook via Admin SDK).
      // Ownership + borough alone are NOT sufficient — that allowed any user to
      // self-promote a "Verified Partner" card. Delete is intentionally NOT gated
      // so a lapsed Partner can still remove their old cards.
      allow create: if isAuth()
        && request.auth.token.partner == true
        && request.resource.data.partnerUid == request.auth.uid
        && boroughKey.lower() == writerBorough().lower()
        && writerBorough() != '';
      // Partner may only update cards in their own borough.
      allow update: if isAuth()
        && request.auth.token.partner == true
        && resource.data.partnerUid == request.auth.uid
        && boroughKey.lower() == writerBorough().lower()
        && writerBorough() != '';
      // Partner may only delete cards in their own borough.
      allow delete: if isAuth()
        && resource.data.partnerUid == request.auth.uid
        && boroughKey.lower() == writerBorough().lower()
        && writerBorough() != '';
    }

    // =========================================================================
    // PARTNER ANALYTICS  (F-05 hardened)
    // =========================================================================
    // partner_analytics/{partnerUid} — flat doc per partner subscriber.
    // Fields: totalProfileViews, totalListingViews, totalBookingClicks,
    //         totalEndorsements, lastUpdated
    //
    // F-05: the previous rule allowed any auth user to write any fields to any
    //   partner's analytics doc — enabling counter zeroing, field injection, or
    //   corruption of a partner's reach metrics.
    //
    // Design: writes are intentionally CROSS-USER (viewer A increments partner B's
    //   counters). Self-write restriction would allow partners to inflate their own
    //   metrics. The correct lock is on WHICH FIELDS may be written, not WHO writes.
    //
    //   Legitimate write paths:
    //     • partner_profile_screen: totalProfileViews + lastUpdated (viewer → partner)
    //     • local_services_service.recordView: totalListingViews + lastUpdated (viewer)
    //   Fields totalBookingClicks and totalEndorsements have no active client write
    //   path — reserved for future use, locked to prevent premature client writes.
    //
    //   Read path: partner reads own doc only (partner_analytics_screen).
    //
    // Fix:
    //   read  — owner reads their own doc (unchanged)
    //   write — any auth user may write, BUT only to the two active counter fields
    //           + lastUpdated. Zeroing, injecting other fields, or overwriting with
    //           set() is blocked because affectedKeys must be a subset of the allowlist.
    // =========================================================================
    match /partner_analytics/{partnerUid} {
      allow read: if isAuth() && request.auth.uid == partnerUid;

      // Any auth user may increment the active view counters (cross-user by design).
      // Split create vs update:
      //   create — doc doesn't exist yet (first view of a new partner's profile).
      //            request.resource.data keys must be a subset of the allowlist.
      //   update — doc already exists (most writes). affectedKeys() (the diff)
      //            must be a subset of the allowlist — prevents field injection,
      //            counter zeroing, and writes to reserved fields.
      allow create: if isAuth()
        && request.resource.data.keys()
             .hasOnly(['totalProfileViews', 'totalListingViews', 'lastUpdated']);
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['totalProfileViews', 'totalListingViews', 'lastUpdated']);
    }

    // =========================================================================
    // STRIPE PROCESSED EVENTS  (idempotency deduplication — backend only)
    // Written by the Railway backend via Admin SDK.  Client never reads/writes.
    // =========================================================================
    match /stripe_processed_events/{eventId} {
      allow read, write: if false;
    }

    // =========================================================================
    // STRIPE SESSIONS  (checkout session tracking)
    // Created by backend at checkout initiation; updated on webhook completion.
    // =========================================================================
    match /stripe_sessions/{sessionId} {
      // User may read their own session to poll for completion.
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      // Backend Admin SDK creates and updates these — no client writes.
      allow write: if false;
    }

    // =========================================================================
    // SAVED MESSAGES  (cross-device bookmark sync)
    // Written by SavedMessageService._syncToFirestore().
    // Doc structure: { userId, messageId, groupId/conversationId, ... }
    // =========================================================================
    match /saved_messages/{docId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      // Users can update their own saved messages (e.g. note field).
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      // Users can delete (unsave) their own saved messages.
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // SAVED THREADS  (pinned thread replies)
    // Written by thread_reply_screen or group_chat_screen save actions.
    // =========================================================================
    match /saved_threads/{docId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // =========================================================================
    // GDPR ERASURE AUDIT LOG  (GDPR-STRIPE-1-R1)
    //
    // Written exclusively by Admin SDK (deleteUserData CF + reconcileGdprErasures CF).
    // Admin SDK bypasses these rules, so the write:false rule is enforced for
    // client SDKs only — intentional.
    //
    // Security invariants:
    //   • NO client read — a user must NEVER read their own erasure audit record
    //     (it may contain stripeCustomerId and step-level error details).
    //   • NO client write — all mutations are Admin-SDK-only.
    //   • isAdmin() grants read for admin/analytics tooling only.
    //   • These records MUST outlive the user doc wipe — intentionally excluded
    //     from every deleteUserData phase.
    // =========================================================================
    match /gdpr_erasure_jobs/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // APP CONFIG  (LAYER-19-NO-VERSION-GATE-1)
    //
    // Version-gate configuration and other operator-managed app settings.
    // Read must be PUBLIC (if true) because the gate runs at splash BEFORE the
    // user has authenticated — requiring isAuth() here would mean unauthenticated
    // or newly-installing users can never be gated.
    //
    // The collection contains NO PII — only version numbers and store URLs.
    // Client writes are categorically denied: all mutations go via the Firebase
    // console or Admin SDK.
    //
    // Key doc: app_config/version_gate
    //   minSupportedBuild   : number   (e.g. 109)
    //   minSupportedVersion : string   (e.g. "1.1.49")  — display only
    //   updateUrlIos        : string   (App Store URL)
    //   updateUrlAndroid    : string   (Play Store URL)
    //   message             : string   (shown on ForceUpdateScreen)
    // =========================================================================
    match /app_config/{docId} {
      // Pre-auth read: gate runs at splash before login.
      allow read: if true;

      // Console / Admin SDK only — no client writes.
      allow write: if false;
    }

    // =========================================================================
    // CATCH-ALL: deny everything not explicitly listed above.
    // Uncomment only for debugging in a dev environment — never in production.
    // =========================================================================
    // match /{document=**} {
    //   allow read, write: if false;
    // }

  }
}
