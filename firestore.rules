rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // LOCAL SERVICES (existing — unchanged)
    // ─────────────────────────────────────────────────────────────────────────
    match /local_services/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;

      match /endorsements/{endorsementId} {
        allow read: if request.auth != null;
        // Prevent self-endorsement: endorser must not be the listing owner
        allow create: if request.auth != null
          && endorsementId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/local_services/$(listingId)).data.createdByUid
              != request.auth.uid;
        allow delete: if request.auth != null
          && endorsementId == request.auth.uid;
        // Owner-reply update: listing owner may only update ownerReply + ownerRepliedAt fields
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/local_services/$(listingId)).data.createdByUid
              == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerReply', 'ownerRepliedAt']);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MARKET — LISTINGS
    // ─────────────────────────────────────────────────────────────────────────
    match /listings/{listingId} {
      // Any authenticated user can read listings (active or otherwise — client
      // filters by status == "active" for the Buy feed).
      allow read: if request.auth != null;

      // Any authenticated user can create a listing, but the createdBy field
      // must match their own UID — prevents creating listings on behalf of others.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // Only the seller (createdBy) may update a listing.
      // Exception: viewCount and saveCount may be incremented atomically by any
      // authenticated user (e.g. on detail-screen open / save/unsave).
      allow update: if request.auth != null && (
        // Seller owns the document — full update rights.
        resource.data.createdBy == request.auth.uid
        ||
        // Any auth user may increment viewCount/saveCount only — no other fields touched.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewCount', 'saveCount', 'updatedAt'])
        )
      );

      // Only the seller may delete their own listing.
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // ───────────────────────────────────────────────────────────────────────
      // SAVES SUB-COLLECTION  listings/{listingId}/saves/{userId}
      // Each document is keyed by the saving user's UID.
      // ───────────────────────────────────────────────────────────────────────
      match /saves/{userId} {
        // Any auth user can read saves (needed to check if current user saved
        // a listing and to maintain saveCount consistency).
        allow read: if request.auth != null;

        // A user can only create or delete their own save document.
        allow create: if request.auth != null
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow delete: if request.auth != null
          && userId == request.auth.uid;

        // Saves are immutable once created — update not permitted.
        allow update: if false;
      }

      // ───────────────────────────────────────────────────────────────────────
      // OFFERS SUB-COLLECTION  listings/{listingId}/offers/{offerId}
      // ───────────────────────────────────────────────────────────────────────
      match /offers/{offerId} {
        // Buyer can read their own offers; seller can read all offers on
        // their listing (needed to show offers in the seller's dashboard).
        allow read: if request.auth != null && (
          // Buyer reads their own offer.
          resource.data.buyerId == request.auth.uid
          ||
          // Seller reads any offer on their listing.
          get(/databases/$(database)/documents/listings/$(listingId)).data.createdBy
            == request.auth.uid
        );

        // Only the buyer may create an offer, and the buyerId field must match
        // their own UID — prevents submitting offers on behalf of others.
        allow create: if request.auth != null
          && request.resource.data.buyerId == request.auth.uid;

        // Seller may update an offer's status ("accepted" / "declined").
        // Buyer may not modify an offer once submitted.
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/listings/$(listingId)).data.createdBy
              == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']);

        // Neither party may delete an offer — soft-delete via status field only.
        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REPORTS (top-level collection — shared across all report types in Huddl)
    //
    // The existing admin dashboard (accessible via the +447575888452 profile
    // → Report button) reads from this collection.  These rules must not break
    // that dashboard — they only restrict writes to authenticated users and
    // reads to the submitting user (admin access is via Firebase Admin SDK /
    // service-account which bypasses security rules).
    // ─────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Any authenticated user can submit a report.
      // The reporterId field must equal the caller's own UID — prevents
      // submitting reports on behalf of others.
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;

      // A user can read their own submitted reports.
      // Admin users (roles.isAdmin == true in their users doc) can read ALL reports
      // — required by AdminDashboardScreen's StreamBuilder.
      allow read: if request.auth != null && (
        resource.data.reporterId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.roles.isAdmin == true
      );

      // Only admin users may update reports (status transitions: reviewed,
      // actioned, dismissed) — all other clients cannot modify reports.
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.roles.isAdmin == true;

      // Reports are never hard-deleted from the client.
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS — SAVED LISTINGS MIRROR
    // Fast lookup for the Saved tab without iterating all listings.
    // users/{userId}/savedListings/{listingId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/savedListings/{listingId} {
      // Users can read and write only their own saved listings mirror.
      allow read, write: if request.auth != null
        && userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GDPR EXPORTS  (§12)
    // Audit trail written when a user triggers Art. 20 data export from the
    // Profile → Settings → View My Data sheet.
    // Each document keyed by an auto-ID; userId field links it to its owner.
    // ─────────────────────────────────────────────────────────────────────────
    match /gdpr_exports/{docId} {
      // Authenticated user may create a record for themselves only.
      // The userId field in the payload must equal their own UID.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // A user may read their own export records.
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Export records are immutable once written — no update or delete from client.
      // (Admin SDK / service accounts bypass these rules for data-pipeline reads.)
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MARKETPLACE  (top-level 'marketplace' collection)
    // Separate from the older /listings/ path; used by RehomeService and
    // createListing() in FirestoreService.
    // ─────────────────────────────────────────────────────────────────────────
    match /marketplace/{itemId} {
      // Any authenticated user can read listings (Buy feed).
      allow read: if request.auth != null;

      // Authenticated user can create a listing; sellerId must match own UID.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid;

      // Only the seller may update their own listing.
      // viewCount / offerCount / favouriteCount may be incremented by any
      // authenticated user (e.g. on detail-screen open or save/unsave).
      allow update: if request.auth != null && (
        resource.data.sellerId == request.auth.uid
        ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount', 'offerCount', 'favouriteCount', 'updatedAt'])
      );

      // Only the seller may delete their own listing.
      // deleteAccount() purges via Admin SDK (bypasses rules) — this covers
      // explicit delist actions from the app client.
      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BOROUGH FEED — PROMOTED CARDS
    // Partner-promoted cards surfaced in the home feed.
    // ─────────────────────────────────────────────────────────────────────────
    match /borough_feed/{docId} {
      allow read: if request.auth != null;
      // Only authenticated users with a partner listing may write promoted cards.
      // Admin SDK writes bypass these rules for server-side promotion management.
      allow create, update: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PARTNER ANALYTICS
    // Per-listing daily view tracking for Partner subscribers.
    // partner_analytics/{listingId}/views/{dateKey}
    // ─────────────────────────────────────────────────────────────────────────
    match /partner_analytics/{listingId} {
      // Listing owner can read their own analytics
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/local_services/$(listingId)).data.ownerUid
            == request.auth.uid;

      match /views/{dateKey} {
        // Any authenticated user may increment view count (anonymous visitor tracking)
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/local_services/$(listingId)).data.ownerUid
              == request.auth.uid;
        // Any auth user can create/update view docs (FieldValue.increment pattern)
        allow create, update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['count', 'updatedAt']);
      }
    }
  }
}
