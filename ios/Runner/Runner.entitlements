<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ── Push Notifications ──────────────────────────────────────────────
	     Required for Firebase phone auth (silent APNs token) and FCM push.
	
	     aps-environment values:
	       development  → direct device install via Xcode (debug builds)
	       production   → TestFlight (internal + external) AND App Store
	
	     IMPORTANT: TestFlight uses the PRODUCTION APNs gateway — NOT
	     development. Using 'development' here causes Firebase phone auth
	     to fail on TestFlight because the APNs token Firebase receives is
	     for the development gateway, but the provisioning profile used by
	     TestFlight/App Store Connect expects production tokens.
	
	     This must ALSO be enabled in Apple Developer Portal:
	       Identifiers → com.huddlconnect.huddlConnect → Push Notifications ✅
	     AND in Xcode:
	       Runner target → Signing & Capabilities → Push Notifications
	────────────────────────────────────────────────────────────────────── -->
	<key>aps-environment</key>
	<string>production</string>

</dict>
</plist>
