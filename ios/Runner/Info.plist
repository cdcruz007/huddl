<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Huddl Connect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>huddl_connect</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── iCloud Key-Value Backup ─────────────────────────────────────────
	     Enables NSUbiquitousKeyValueStore so that SharedPreferences data is
	     mirrored to iCloud and automatically restored when the user reinstalls
	     the app or switches to a new iPhone.
	     The container identifier must match the one in your Apple Developer
	     account under Identifiers → App ID → iCloud.
	     Use your actual team-prefixed bundle ID, e.g.:
	         iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
	──────────────────────────────────────────────────────────────────────── -->
	<key>NSUbiquitousKeyValueStoreIdentifier</key>
	<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- ── Firebase URL schemes ──────────────────────────────────────────────
	     Huddl Connect uses Firebase Phone Authentication (SMS OTP) only.
	     There is NO Google Sign-In, so no REVERSED_CLIENT_ID is required.

	     The two schemes registered below are:
	     1. The app's bundle ID — required by Firebase phone auth for the
	        reCAPTCHA web-based fallback flow on iOS.
	     2. The GOOGLE_APP_ID encoded as a URL scheme — used internally by
	        the Firebase iOS SDK for app-verification callbacks.

	     If you add Google Sign-In in the future, also add a third scheme
	     entry with the REVERSED_CLIENT_ID value from GoogleService-Info.plist
	     (e.g. com.googleusercontent.apps.879152141283-xxxxxxxxxx).
	────────────────────────────────────────────────────────────────────── -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Bundle ID scheme — Firebase phone auth reCAPTCHA fallback -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.huddlconnect.huddlConnect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.huddlconnect.huddlConnect</string>
			</array>
		</dict>
		<!-- Google App ID scheme — Firebase internal app-verification callback -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google.app.id</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- GOOGLE_APP_ID from GoogleService-Info.plist with colons replaced by dashes -->
				<string>1-879152141283-ios-bdac2f6012c53a8d9186d6</string>
			</array>
		</dict>
	</array>

	<!-- ── Privacy usage descriptions (required by App Store / TestFlight) ──
	     Apple rejects any build that uses a permission-requiring API without
	     a corresponding NSXxxUsageDescription key here. Each string is shown
	     to the user in the system permission dialog.
	────────────────────────────────────────────────────────────────────── -->

	<!-- Camera — used by image_picker when taking a profile photo or
	     posting a photo in a group / marketplace listing -->
	<key>NSCameraUsageDescription</key>
	<string>Huddl Connect uses the camera to let you take profile photos and share images in groups and marketplace listings.</string>

	<!-- Photo library read — used by image_picker to select existing photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Huddl Connect accesses your photo library so you can choose photos for your profile, groups, and marketplace listings.</string>

	<!-- Photo library write — used by image_picker / image_cropper to save
	     edited images back to the camera roll -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Huddl Connect may save edited profile or group photos to your photo library.</string>

	<!-- Microphone — required by image_picker when recording video clips -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Huddl Connect requests microphone access to allow video recording when sharing content in groups.</string>

	<!-- Face ID — used by local_auth for biometric login lock -->
	<key>NSFaceIDUsageDescription</key>
	<string>Huddl Connect uses Face ID to protect your account with biometric login.</string>

	<!-- File access — used by file_picker to attach documents in
	     marketplace listings or group posts -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Huddl Connect accesses your files to let you attach documents to marketplace listings and group posts.</string>

	<!-- Push Notifications — required for Firebase Cloud Messaging (FCM)
	     which powers group and DM notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

</dict>
</plist>
