<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Huddl Connect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Huddl Connect</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Firebase URL schemes ──────────────────────────────────────────────
	     TWO schemes are required by Firebase phone auth on iOS:
	     1. GOOGLE_APP_ID scheme: 'app-1-879152141283-ios-bdac2f6012c53a8d9186d6'
	        Required by Firebase SDK for phone auth reCAPTCHA fallback callback.
	        Firebase explicitly errors if this is missing:
	        "Please register custom URL scheme 'app-1-...' in Info.plist"
	     2. Bundle ID scheme: 'com.huddlconnect.huddlConnect'
	        Required for Firebase dynamic links and general Firebase callbacks.
	────────────────────────────────────────────────────────────────────── -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- REQUIRED: GOOGLE_APP_ID scheme for Firebase phone auth reCAPTCHA -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-app-id</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-879152141283-ios-bdac2f6012c53a8d9186d6</string>
			</array>
		</dict>
		<!-- Bundle ID scheme — Firebase general callbacks -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.huddlconnect.huddlConnect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.huddlconnect.huddlConnect</string>
			</array>
		</dict>
	</array>

	<!-- ── Privacy usage descriptions (required by App Store / TestFlight) ──
	     Apple rejects any build that uses a permission-requiring API without
	     a corresponding NSXxxUsageDescription key here. Each string is shown
	     to the user in the system permission dialog.
	────────────────────────────────────────────────────────────────────── -->

	<!-- Camera — used by image_picker when taking a profile photo or
	     posting a photo in a group / marketplace listing -->
	<key>NSCameraUsageDescription</key>
	<string>Huddl Connect uses the camera to let you take profile photos and share images in groups and marketplace listings.</string>

	<!-- Photo library read — used by image_picker to select existing photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Huddl Connect accesses your photo library so you can choose photos for your profile, groups, and marketplace listings.</string>

	<!-- Photo library write — used by image_picker / image_cropper to save
	     edited images back to the camera roll -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Huddl Connect may save edited profile or group photos to your photo library.</string>

	<!-- Microphone — required by image_picker when recording video clips -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Huddl Connect requests microphone access to allow video recording when sharing content in groups.</string>

	<!-- Face ID — used by local_auth for biometric login lock -->
	<key>NSFaceIDUsageDescription</key>
	<string>Huddl Connect uses Face ID to protect your account with biometric login.</string>

	<!-- File access — used by file_picker to attach documents in
	     marketplace listings or group posts -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Huddl Connect accesses your files to let you attach documents to marketplace listings and group posts.</string>

	<!-- Push Notifications — required for Firebase Cloud Messaging (FCM)
	     which powers group and DM notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

</dict>
</plist>
