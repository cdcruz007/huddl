<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Huddl</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Huddl</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Firebase URL schemes ──────────────────────────────────────────────
	     TWO schemes are required by Firebase phone auth on iOS:
	     1. GOOGLE_APP_ID scheme: 'app-1-879152141283-ios-bdac2f6012c53a8d9186d6'
	        Required by Firebase SDK for phone auth reCAPTCHA fallback callback.
	        Firebase explicitly errors if this is missing:
	        "Please register custom URL scheme 'app-1-...' in Info.plist"
	     2. Bundle ID scheme: 'com.huddlconnect.huddlConnect'
	        Required for Firebase dynamic links and general Firebase callbacks.
	────────────────────────────────────────────────────────────────────── -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- REQUIRED: GOOGLE_APP_ID scheme for Firebase phone auth reCAPTCHA -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-app-id</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-879152141283-ios-bdac2f6012c53a8d9186d6</string>
			</array>
		</dict>
		<!-- Bundle ID scheme — Firebase general callbacks -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.huddlconnect.huddlConnect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.huddlconnect.huddlConnect</string>
			</array>
		</dict>
	</array>

	<!-- ── Privacy usage descriptions (required by App Store / TestFlight) ──
	     Apple rejects any build that uses a permission-requiring API without
	     a corresponding NSXxxUsageDescription key here. Each string is shown
	     to the user in the system permission dialog.
	────────────────────────────────────────────────────────────────────── -->

	<!-- Camera — used by image_picker when taking a profile photo or
	     posting a photo in a group / marketplace listing -->
	<key>NSCameraUsageDescription</key>
	<string>Huddl uses the camera to let you take profile photos and share images in groups and marketplace listings.</string>

	<!-- Photo library read — used by image_picker to select existing photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Huddl accesses your photo library so you can choose photos for your profile, groups, and marketplace listings.</string>

	<!-- Photo library write — used by image_picker / image_cropper to save
	     edited images back to the camera roll -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Huddl may save edited profile or group photos to your photo library.</string>

	<!-- Microphone — required for voice messages and video recording -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Huddl uses the microphone to record voice messages in chats and videos when sharing content in groups.</string>

	<!-- Location — used for sharing current location in chat messages -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Huddl uses your location to share it with other group members in chat.</string>

	<!-- Location Always — required by Apple when any location API is referenced,
	     even if the app only requests "when in use" at runtime -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Huddl uses your location to share it with other group members in chat.</string>

	<!-- Location Always (legacy iOS 10 key — required alongside the above) -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Huddl uses your location to share it with other group members in chat.</string>

	<!-- Contacts — used for the Contact sharing feature in group and DM chats -->
	<key>NSContactsUsageDescription</key>
	<string>Huddl accesses your contacts so you can share contact cards with other members in group and direct message chats.</string>

	<!-- Face ID — used by local_auth for biometric login lock -->
	<key>NSFaceIDUsageDescription</key>
	<string>Huddl uses Face ID to protect your account with biometric login.</string>

	<!-- File access — used by file_picker to attach documents in
	     marketplace listings or group posts -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Huddl accesses your files to let you attach documents to marketplace listings and group posts.</string>

	<!-- Push Notifications — required for Firebase Cloud Messaging (FCM)
	     which powers group and DM notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ── App Transport Security ───────────────────────────────────────────
	     Firebase Storage download URLs are served over HTTPS, but iOS ATS
	     can still reject connections on some network configurations or if the
	     CDN uses certificate pinning that differs from ATS expectations.
	     NSAllowsArbitraryLoads lets audioplayers stream the signed HTTPS URL
	     without ATS blocking it. This is consistent with Firebase's own
	     recommended Info.plist configuration for Storage access on iOS.
	────────────────────────────────────────────────────────────────────── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

</dict>
</plist>
