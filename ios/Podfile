# ─────────────────────────────────────────────────────────────────────────────
# Huddl Connect — iOS Podfile
#
# Minimum iOS version: 13.0
#   • Firebase requires iOS 13+
#   • in_app_purchase (StoreKit) requires iOS 11.4+ (we use 13 to be safe)
#   • local_auth (Face ID) requires iOS 9+
#   • Flutter itself requires iOS 12+ from Flutter 3.x
#
# DO NOT lower this below 13.0 — Firebase packages will break.
#
# ── Firebase iOS SDK version pin ─────────────────────────────────────────────
# firebase_auth 5.1.0 + firebase_core 3.1.0 require Firebase iOS SDK 10.27.0.
# FirebaseAuth 11.x (SDK >=11.0) contains a hard assertionFailure in
# verifyPhoneNumber that crashes on iOS 18 without an APNs token (SIGTRAP).
# FirebaseAuth 10.x does NOT have this bug.
#
# $FirebaseSDKVersion forces ALL FlutterFire pods to use this exact SDK
# version, overriding whatever the CocoaPods spec repo resolves.
# DO NOT change this without first verifying the new firebase_auth pub package
# still targets Firebase iOS SDK 10.x.
# ─────────────────────────────────────────────────────────────────────────────
$FirebaseSDKVersion = '10.27.0'

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Hard-pin Firebase iOS SDK to 10.27.0 ─────────────────────────────────
  # firebase_auth 5.1.0 / firebase_core 3.1.0 target Firebase iOS SDK 10.27.0.
  # FirebaseAuth 11.x has a hard assertionFailure in verifyPhoneNumber that
  # crashes on iOS 18 without APNs (EXC_BREAKPOINT / SIGTRAP).
  #
  # The explicit pod directives below are the ONLY reliable way to prevent
  # CocoaPods from resolving a newer version when the Mac pub cache contains
  # a newer firebase_auth package (e.g. 5.3.1) alongside the locked 5.1.0.
  # $FirebaseSDKVersion alone is not sufficient — if a newer FlutterFire
  # podspec slips through via the Mac pub cache, it can override the variable.
  #
  # Firebase uses a single versioned umbrella pod. All subspecs share the same
  # version number, so pinning 'Firebase' to 10.27.0 locks all of them.
  #
  # DO NOT change this version without verifying the new firebase_auth
  # pub package still requires Firebase iOS SDK 10.x.
  pod 'Firebase', '= 10.27.0'
  # ─────────────────────────────────────────────────────────────────────────

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ── Enforce minimum iOS deployment target across ALL pods ─────────────
    # Some older pods declare a lower minimum — this override prevents
    # Xcode warnings and build errors about deployment target mismatch.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # ── Silence warnings that clutter the build log ───────────────────
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end
  end
end
