# ─────────────────────────────────────────────────────────────────────────────
# Huddl Connect — iOS Podfile
#
# Minimum iOS version: 13.0
#   • Firebase requires iOS 13+
#   • in_app_purchase (StoreKit) requires iOS 11.4+ (we use 13 to be safe)
#   • local_auth (Face ID) requires iOS 9+
#   • Flutter itself requires iOS 12+ from Flutter 3.x
#
# DO NOT lower this below 13.0 — Firebase packages will break.
#
# ── Firebase iOS SDK version pin ─────────────────────────────────────────────
# firebase_auth 5.1.0 + firebase_core 3.1.0 require Firebase iOS SDK 10.27.0.
# FirebaseAuth 11.x (SDK >=11.0) contains a hard assertionFailure in
# verifyPhoneNumber that crashes on iOS 18 without an APNs token (SIGTRAP).
# FirebaseAuth 10.x does NOT have this bug.
#
# $FirebaseSDKVersion forces ALL FlutterFire pods to use this exact SDK
# version, overriding whatever the CocoaPods spec repo resolves.
# DO NOT change this without first verifying the new firebase_auth pub package
# still targets Firebase iOS SDK 10.x.
# ─────────────────────────────────────────────────────────────────────────────
$FirebaseSDKVersion = '10.27.0'

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Hard-pin Firebase iOS SDK to 10.27.0 ─────────────────────────────────
  # firebase_auth 5.1.0 / firebase_core 3.1.0 target Firebase iOS SDK 10.27.0.
  # FirebaseAuth 11.x has a hard assertionFailure in verifyPhoneNumber that
  # crashes on iOS 18 without APNs (EXC_BREAKPOINT / SIGTRAP).
  #
  # The explicit pod directives below are the ONLY reliable way to prevent
  # CocoaPods from resolving a newer version when the Mac pub cache contains
  # a newer firebase_auth package (e.g. 5.3.1) alongside the locked 5.1.0.
  # $FirebaseSDKVersion alone is not sufficient — if a newer FlutterFire
  # podspec slips through via the Mac pub cache, it can override the variable.
  #
  # Firebase uses a single versioned umbrella pod. All subspecs share the same
  # version number, so pinning 'Firebase' to 10.27.0 locks all of them.
  #
  # DO NOT change this version without verifying the new firebase_auth
  # pub package still requires Firebase iOS SDK 10.x.
  pod 'Firebase', '= 10.27.0'
  # ─────────────────────────────────────────────────────────────────────────

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # ── Targets that inject the unsupported '-G' flag on Xcode 16 / arm64 ────
  # Xcode 16 clang rejects '-G' (MIPS small-data flag) on arm64 targets.
  # The flag originates from build settings inherited into the compiler
  # response files (.resp) for BoringSSL-GRPC, gRPC-C++, gRPC-Core, and
  # FirebaseFirestoreInternal. We must override OTHER_CFLAGS / OTHER_CPLUSPLUSFLAGS
  # for ALL of these targets, not just BoringSSL-GRPC.
  GRPC_TARGETS = %w[
    BoringSSL-GRPC
    gRPC-C++
    gRPC-Core
    FirebaseFirestoreInternal
    abseil
  ].freeze

  # Safe warning-suppression flags that are valid on arm64 (no -G).
  SAFE_CFLAGS = '$(inherited) -Wno-comma -Wno-unreachable-code -Wno-shorten-64-to-32'.freeze

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # ── Enforce minimum iOS deployment target for all pods ────────────────
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # ── Strip -G from every affected gRPC / Firestore target ─────────────
      # For exact name matches AND prefix matches (e.g. BoringSSL-GRPC_Privacy).
      is_affected = GRPC_TARGETS.any? { |t| target.name == t || target.name.start_with?(t) }
      next unless is_affected

      # Override OTHER_CFLAGS and OTHER_CPLUSPLUSFLAGS with safe flags only.
      config.build_settings['OTHER_CFLAGS'] = SAFE_CFLAGS
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = SAFE_CFLAGS

      # Remove any arch-specific overrides that could reintroduce -G.
      config.build_settings.delete('OTHER_CFLAGS[arch=*]')
      config.build_settings.delete('OTHER_CPLUSPLUSFLAGS[arch=*]')

      # Strip -G from HEADER_SEARCH_PATHS in case it leaked in there.
      if config.build_settings['HEADER_SEARCH_PATHS']
        paths = config.build_settings['HEADER_SEARCH_PATHS']
        if paths.is_a?(Array)
          paths = paths.map { |p| p.gsub(/-G\S*/, '').strip }.reject(&:empty?)
          config.build_settings['HEADER_SEARCH_PATHS'] = paths
        elsif paths.is_a?(String) && paths.include?('-G')
          config.build_settings['HEADER_SEARCH_PATHS'] = paths.gsub(/-G\S*/, '').strip
        end
      end

      puts "  [Podfile] Stripped -G flags from #{target.name} (#{config.name})"
    end
  end

  # ── Patch shell script build phases: strip -G injected at build time ─────
  # Some gRPC-Core script phases write -G flags into generated files at
  # build time (e.g. prepare_boringssl.sh). Patch the in-memory script so
  # the written files are clean when Xcode executes them.
  installer.pods_project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:shell_script)
      next if phase.shell_script.nil?
      next unless phase.shell_script.include?('-G ')
      original = phase.shell_script
      phase.shell_script = original.gsub(/ -G \$[^\s"']+/, '').gsub(/ -G (?![-\w])/, ' ')
      puts "  [Podfile] Patched -G from script phase: #{target.name}/#{phase.display_name}"
    end
  end

  # ── Patch generated .xcconfig files on disk ──────────────────────────────
  # CocoaPods writes xcconfig files before post_install runs; patch them now
  # so that Xcode reads clean files. This covers any -G that ended up in
  # OTHER_CFLAGS, OTHER_CPLUSPLUSFLAGS, or HEADER_SEARCH_PATHS on disk.
  xcconfig_dir = File.join(installer.sandbox.root, 'Target Support Files')
  Dir.glob(File.join(xcconfig_dir, '**', '*.xcconfig')).each do |path|
    content = File.read(path)
    # Only touch files that mention -G followed by a non-flag character
    next unless content.match?(/ -G[^-\w]| -G$/)
    patched = content.gsub(/ -G\$[^\s"']+/, '').gsub(/ -G (?![-\w])/, ' ')
    next if patched == content
    File.write(path, patched)
    puts "  [Podfile] Patched -G in xcconfig: #{File.basename(path)}"
  end

  # ── Patch .sh scripts in the Pods sandbox ────────────────────────────────
  Dir.glob(File.join(installer.sandbox.root, '**', '*.sh')).each do |sh_path|
    content = File.read(sh_path)
    next unless content.include?('-G ')
    patched = content.gsub(/ -G \$[^\s"']+/, '').gsub(/ -G (?![-\w])/, ' ')
    next if patched == content
    File.write(sh_path, patched)
    puts "  [Podfile] Patched -G in script: #{File.basename(sh_path)}"
  end
end
