# ─────────────────────────────────────────────────────────────────────────────
# Huddl Connect — iOS Podfile
#
# Minimum iOS version: 13.0
#   • Firebase requires iOS 13+
#   • DO NOT lower below 13.0 — Firebase packages will break.
#
# ── Firebase iOS SDK version pin ─────────────────────────────────────────────
# firebase_auth 5.1.0 + firebase_core 3.1.0 → Firebase iOS SDK 10.27.0
# FirebaseAuth 11.x crashes on iOS 18 (SIGTRAP/EXC_BREAKPOINT) without APNs.
# FirebaseAuth 10.x does NOT have this bug.
# DO NOT change without verifying new firebase_auth still targets SDK 10.x.
# ─────────────────────────────────────────────────────────────────────────────
$FirebaseSDKVersion = '10.27.0'

platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # ── Framework linkage ────────────────────────────────────────────────────
  # use_frameworks! is required by FlutterFire (Swift pods need dynamic frameworks).
  # use_modular_headers! is intentionally OMITTED — it causes:
  #   "Include of non-modular header inside framework module"
  # for firebase_messaging, firebase_crashlytics, etc. whose Objective-C headers
  # do #import <Firebase/Firebase.h> (a non-modular umbrella import).
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Hard-pin Firebase iOS SDK to 10.27.0 ─────────────────────────────────
  # The explicit pod directive is the ONLY reliable lock — $FirebaseSDKVersion
  # alone can be overridden by a newer FlutterFire podspec in the Mac pub cache.
  pod 'Firebase', '= 10.27.0'

  # ── Use pre-compiled Firestore binary to avoid gRPC-C++ compile hang ─────
  # FirebaseFirestore/Binary ships a pre-built XCFramework that skips compiling
  # gRPC-Core + gRPC-C++ (~1,500 C++ files). Without this, the first Xcode build
  # hangs for 20-45 min. The binary subspec is functionally identical.
  pod 'FirebaseFirestore/Binary', '= 10.27.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Helper: patch basic_seq.h (gRPC-Core Xcode 16 C++17 fix)
# ─────────────────────────────────────────────────────────────────────────────
def patch_basic_seq(root_dir)
  patched_any = false
  Dir.glob(File.join(root_dir, '**/basic_seq.h')).each do |path|
    next unless File.exist?(path)
    content = File.read(path)
    if content.include?('CallSeqFactory(') && !content.include?('CallSeqFactory<>(')
      File.write(path, content.gsub('CallSeqFactory(', 'CallSeqFactory<>('))
      puts "  [Podfile] PATCHED basic_seq.h: #{path}"
      patched_any = true
    elsif content.include?('CallSeqFactory<>(')
      puts "  [Podfile] basic_seq.h already patched: #{path}"
    end
  end
  patched_any
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # ── Minimum deployment target ──────────────────────────────────────────
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # ── Suppress warnings ─────────────────────────────────────────────────
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS']  = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS']        = 'YES'

      # ── Non-modular header fix ────────────────────────────────────────────
      # FLTFirebaseMessagingPlugin.h (and other Firebase ObjC headers) do:
      #   #import <Firebase/Firebase.h>
      # which is a non-modular umbrella import. With use_frameworks! CocoaPods
      # generates a module map for each pod; Clang then rejects any non-modular
      # #import inside that module. Setting this key to YES silences the error.
      # This is the only correct fix when use_frameworks! must be kept for
      # Swift pods (FlutterFire requires dynamic frameworks).
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # ── Parallel compilation ───────────────────────────────────────────────
      # Allow Clang to use all available CPU cores per file. Speeds up builds
      # significantly on Apple Silicon Macs.
      config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
    end

    # ── Strip -G from per-file COMPILER_FLAGS (BoringSSL-GRPC) ───────────────
    # Xcode 16 rejects the MIPS '-G' flag on arm64. BoringSSL-GRPC embeds
    # '-GCC_WARN_INHIBIT_ALL_WARNINGS' in per-file COMPILER_FLAGS; Clang
    # tokenises it as '-G' + 'CC_WARN_INHIBIT_ALL_WARNINGS'. Per-file flags
    # bypass OTHER_CFLAGS, so we must strip them here.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings&.key?('COMPILER_FLAGS')
        original = file.settings['COMPILER_FLAGS']
        cleaned  = original.split
                           .reject { |f| f == '-G' || (f.start_with?('-G') && f.length > 2 && f[2] != '-') }
                           .join(' ')
        next if cleaned == original
        file.settings['COMPILER_FLAGS'] = cleaned
        puts "  [Podfile] BoringSSL-GRPC: stripped -G from #{file.file_ref&.path || 'unknown'}"
      end
    end
  end

  # Save xcodeproj after all target mutations
  installer.pods_project.save

  # ── Patch xcconfig files on disk ─────────────────────────────────────────
  # post_install build_settings writes apply to the in-memory xcodeproj, but
  # CocoaPods also generates .xcconfig files that Xcode reads directly.
  # We must add CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES there too.
  puts '  [Podfile] Patching generated xcconfig files...'
  xcconfig_dir = File.join(installer.sandbox.root.to_s, 'Target Support Files')
  Dir.glob(File.join(xcconfig_dir, '**/*.xcconfig')).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    key = 'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
    unless content.include?(key)
      File.open(xcconfig_path, 'a') { |f| f.puts "\n#{key} = YES" }
    end
  end
  puts '  [Podfile] xcconfig patch done.'

  # ── Patch gRPC-Core basic_seq.h for Xcode 16 C++17 ───────────────────────
  puts '  [Podfile] === Patching basic_seq.h for Xcode 16 C++17 compatibility ==='
  sandbox_root = installer.sandbox.root.to_s
  podfile_dir  = File.dirname(File.realpath(__FILE__))
  total_patched = [sandbox_root, podfile_dir].uniq
                                             .map { |r| patch_basic_seq(r) }
                                             .any?
  if total_patched
    puts '  [Podfile] === basic_seq.h: PATCHED ==='
  else
    all_found = Dir.glob(File.join(sandbox_root, '**/basic_seq.h'))
    if all_found.empty?
      puts '  [Podfile] WARNING: basic_seq.h not found — gRPC-Core may not be installed'
    else
      all_found.each do |f|
        line = File.readlines(f).find { |l| l.include?('CallSeqFactory') }
        puts "  [Podfile] #{f}: #{line&.strip || '(no CallSeqFactory line)'}"
      end
      puts '  [Podfile] === basic_seq.h: already patched ==='
    end
  end

  # ── Add compile-time Run Script to gRPC-Core (belt-and-suspenders) ────────
  # Patches basic_seq.h again at Xcode compile time in case DerivedData cached
  # the old compiled .o. Added only once (idempotent check on phase name).
  installer.pods_project.targets.each do |target|
    next unless target.name == 'gRPC-Core'
    next if target.shell_script_build_phases.any? { |p| p.name == 'Fix basic_seq.h Xcode16' }
    phase = target.new_shell_script_build_phase('Fix basic_seq.h Xcode16')
    phase.shell_script = <<~'SHELL'
      FILE="${PODS_ROOT}/gRPC-Core/src/core/lib/promise/detail/basic_seq.h"
      if [ -f "$FILE" ]; then
        if grep -q 'CallSeqFactory(' "$FILE" && ! grep -q 'CallSeqFactory<>(' "$FILE"; then
          sed -i '' 's/CallSeqFactory(/CallSeqFactory<>(/g' "$FILE"
          echo "[Fix basic_seq.h] Patched: $FILE"
        else
          echo "[Fix basic_seq.h] Already patched: $FILE"
        fi
      else
        echo "[Fix basic_seq.h] Not found: $FILE"
      fi
    SHELL
    phase.run_only_for_deployment_postprocessing = '0'
    puts '  [Podfile] Added Run Script to gRPC-Core: Fix basic_seq.h Xcode16'
  end

  installer.pods_project.save
end
