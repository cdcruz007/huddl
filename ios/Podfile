# ─────────────────────────────────────────────────────────────────────────────
# Huddl Connect — iOS Podfile
#
# Minimum iOS version: 13.0
#   • Firebase requires iOS 13+
#   • in_app_purchase (StoreKit) requires iOS 11.4+ (we use 13 to be safe)
#   • local_auth (Face ID) requires iOS 9+
#   • Flutter itself requires iOS 12+ from Flutter 3.x
#
# DO NOT lower this below 13.0 — Firebase packages will break.
#
# ── Firebase iOS SDK version pin ─────────────────────────────────────────────
# firebase_auth 5.1.0 + firebase_core 3.1.0 require Firebase iOS SDK 10.27.0.
# FirebaseAuth 11.x (SDK >=11.0) contains a hard assertionFailure in
# verifyPhoneNumber that crashes on iOS 18 without an APNs token (SIGTRAP).
# FirebaseAuth 10.x does NOT have this bug.
#
# $FirebaseSDKVersion forces ALL FlutterFire pods to use this exact SDK
# version, overriding whatever the CocoaPods spec repo resolves.
# DO NOT change this without first verifying the new firebase_auth pub package
# still targets Firebase iOS SDK 10.x.
# ─────────────────────────────────────────────────────────────────────────────
$FirebaseSDKVersion = '10.27.0'

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Hard-pin Firebase iOS SDK to 10.27.0 ─────────────────────────────────
  # firebase_auth 5.1.0 / firebase_core 3.1.0 target Firebase iOS SDK 10.27.0.
  # FirebaseAuth 11.x has a hard assertionFailure in verifyPhoneNumber that
  # crashes on iOS 18 without APNs (EXC_BREAKPOINT / SIGTRAP).
  #
  # The explicit pod directive below is the ONLY reliable way to prevent
  # CocoaPods from resolving a newer version when the Mac pub cache contains
  # a newer firebase_auth package (e.g. 5.3.1) alongside the locked 5.1.0.
  # $FirebaseSDKVersion alone is not sufficient — if a newer FlutterFire
  # podspec slips through via the Mac pub cache, it can override the variable.
  #
  # Firebase uses a single versioned umbrella pod. All subspecs share the same
  # version number, so pinning 'Firebase' to 10.27.0 locks all of them.
  #
  # DO NOT change this version without verifying the new firebase_auth
  # pub package still requires Firebase iOS SDK 10.x.
  pod 'Firebase', '= 10.27.0'
  # ─────────────────────────────────────────────────────────────────────────

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ── 1. Enforce minimum deployment target + suppress warnings (all pods) ──
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end

    # ── 2. Strip -G from per-file COMPILER_FLAGS (BoringSSL-GRPC) ────────────
    #
    # ROOT CAUSE: Xcode 16 clang rejects the MIPS small-data flag '-G' on arm64.
    # BoringSSL-GRPC embeds '-GCC_WARN_INHIBIT_ALL_WARNINGS' in per-source-file
    # COMPILER_FLAGS. Xcode 16 tokenises it as '-G' + 'CC_WARN_INHIBIT_ALL_WARNINGS'
    # and rejects the bare '-G' (MIPS flag, invalid on arm64).
    # This causes errors on sub-targets x_val, x_x509, x_x509a.
    #
    # FIX: iterate source_build_phase.files and strip the bad tokens.
    # Overriding OTHER_CFLAGS has NO effect — per-file flags bypass it.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings&.key?('COMPILER_FLAGS')
        original = file.settings['COMPILER_FLAGS']
        cleaned = original
          .split
          .reject { |f| f == '-G' || (f.start_with?('-G') && f.length > 2 && f[2] != '-') }
          .join(' ')
        next if cleaned == original
        file.settings['COMPILER_FLAGS'] = cleaned
        puts "  [Podfile] BoringSSL-GRPC: stripped -G from #{file.file_ref&.path || 'unknown'}"
      end
    end
  end

  # ── 3. Patch gRPC-Core basic_seq.h: fix C++ template syntax for Xcode 16 ──
  #
  # ROOT CAUSE: Xcode 16 Clang strictly enforces C++17: a dependent-name
  # template call like  Traits::template CallSeqFactory(...)  must be written
  # as  Traits::template CallSeqFactory<>(...)  when no template args are
  # passed. Older Clang accepted both; Xcode 16 rejects the form without <>.
  # This fires as "A template argument list is expected after a name prefixed
  # by the template keyword" on basic_seq.h line ~102 (target basic_seq under
  # gRPC-Core).
  #
  # FIX: locate basic_seq.h anywhere under the Pods sandbox and patch the
  # line in-place. Uses multiple path strategies so it works regardless of
  # CocoaPods version, sandbox layout, or whether Pods/ is a symlink.
  # The gsub is idempotent — CallSeqFactory<>(...) is left unchanged.

  # Regex matches ANY whitespace variant of the problematic line and any
  # argument names — the only invariant is CallSeqFactory without <>.
  # The negative lookahead (?!<) ensures we skip already-patched lines.
  bad_pattern = /Traits::template\s+CallSeqFactory\s*(?!<)\(([^)]*)\);/

  podfile_dir = File.dirname(File.realpath(__FILE__))

  # All candidate paths for basic_seq.h (tried in order, deduped)
  candidate_paths = [
    File.join(installer.sandbox.root.to_s,
              'gRPC-Core/src/core/lib/promise/detail/basic_seq.h'),
    File.join(podfile_dir,
              'Pods/gRPC-Core/src/core/lib/promise/detail/basic_seq.h'),
  ]
  # Glob under sandbox root catches any depth / symlink layout
  Dir.glob(File.join(installer.sandbox.root.to_s, '**/basic_seq.h')).each do |p|
    candidate_paths << p
  end
  # Final fallback: entire ios/ tree
  Dir.glob(File.join(podfile_dir, '**/basic_seq.h')).each do |p|
    candidate_paths << p
  end

  patched_any = false
  candidate_paths.uniq.each do |path|
    next unless File.exist?(path)
    content = File.read(path)

    if content.match?(bad_pattern)
      # Replace: insert <> between CallSeqFactory and (
      patched = content.gsub(bad_pattern) do |match|
        match.sub('CallSeqFactory(', 'CallSeqFactory<>(')
      end
      File.write(path, patched)
      puts "  [Podfile] Patched basic_seq.h at: #{path}"
      patched_any = true
    elsif content.include?('CallSeqFactory<>')
      puts "  [Podfile] basic_seq.h already patched at: #{path}"
    else
      # Print the actual CallSeqFactory line for diagnosis
      content.each_line do |line|
        puts "  [Podfile] basic_seq.h line: #{line.rstrip}" if line.include?('CallSeqFactory')
      end
    end
  end

  if patched_any
    puts '  [Podfile] gRPC-Core basic_seq.h: CallSeqFactory<> fix applied OK'
  elsif candidate_paths.uniq.any? { |p| File.exist?(p) }
    puts '  [Podfile] gRPC-Core basic_seq.h: already patched — OK'
  else
    puts '  [Podfile] WARNING: basic_seq.h not found under Pods/'
  end
end
