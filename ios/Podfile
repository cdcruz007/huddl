# ─────────────────────────────────────────────────────────────────────────────
# Huddl Connect — iOS Podfile
#
# Minimum iOS version: 13.0
#   • Firebase requires iOS 13+
#   • in_app_purchase (StoreKit) requires iOS 11.4+ (we use 13 to be safe)
#   • local_auth (Face ID) requires iOS 9+
#   • Flutter itself requires iOS 12+ from Flutter 3.x
#
# DO NOT lower this below 13.0 — Firebase packages will break.
#
# ── Firebase iOS SDK version pin ─────────────────────────────────────────────
# firebase_auth 5.1.0 + firebase_core 3.1.0 require Firebase iOS SDK 10.27.0.
# FirebaseAuth 11.x (SDK >=11.0) contains a hard assertionFailure in
# verifyPhoneNumber that crashes on iOS 18 without an APNs token (SIGTRAP).
# FirebaseAuth 10.x does NOT have this bug.
#
# $FirebaseSDKVersion forces ALL FlutterFire pods to use this exact SDK
# version, overriding whatever the CocoaPods spec repo resolves.
# DO NOT change this without first verifying the new firebase_auth pub package
# still targets Firebase iOS SDK 10.x.
# ─────────────────────────────────────────────────────────────────────────────
$FirebaseSDKVersion = '10.27.0'

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── Hard-pin Firebase iOS SDK to 10.27.0 ─────────────────────────────────
  # firebase_auth 5.1.0 / firebase_core 3.1.0 target Firebase iOS SDK 10.27.0.
  # FirebaseAuth 11.x has a hard assertionFailure in verifyPhoneNumber that
  # crashes on iOS 18 without APNs (EXC_BREAKPOINT / SIGTRAP).
  #
  # The explicit pod directive below is the ONLY reliable way to prevent
  # CocoaPods from resolving a newer version when the Mac pub cache contains
  # a newer firebase_auth package (e.g. 5.3.1) alongside the locked 5.1.0.
  # $FirebaseSDKVersion alone is not sufficient — if a newer FlutterFire
  # podspec slips through via the Mac pub cache, it can override the variable.
  #
  # Firebase uses a single versioned umbrella pod. All subspecs share the same
  # version number, so pinning 'Firebase' to 10.27.0 locks all of them.
  #
  # DO NOT change this version without verifying the new firebase_auth
  # pub package still requires Firebase iOS SDK 10.x.
  pod 'Firebase', '= 10.27.0'
  # ─────────────────────────────────────────────────────────────────────────

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ── 1. Enforce minimum deployment target + suppress warnings (all pods) ──
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end

    # ── 2. Strip -G from per-file COMPILER_FLAGS (BoringSSL-GRPC) ────────────
    #
    # ROOT CAUSE: Xcode 16 clang rejects the MIPS small-data flag '-G' on arm64.
    # BoringSSL-GRPC stores per-SOURCE-FILE compiler flags in
    # source_build_phase.files[].settings['COMPILER_FLAGS']. These are separate
    # from the target-level OTHER_CFLAGS, so overriding OTHER_CFLAGS has NO
    # effect on them. The sub-targets x_val, x_x509, x_x509a each compile one
    # ASN.1 source file that carries '-GCC_WARN_INHIBIT_ALL_WARNINGS' (which
    # clang misparses as '-G CC_WARN_INHIBIT_ALL_WARNINGS' on arm64).
    #
    # FIX: iterate every file in BoringSSL-GRPC's source build phase and strip
    # any token that is exactly '-G' or starts with '-G' followed by a
    # non-dash character.
    # References: https://stackoverflow.com/questions/78608693
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings&.key?('COMPILER_FLAGS')
        original_flags = file.settings['COMPILER_FLAGS']
        cleaned_flags = original_flags
          .split
          .reject { |f| f == '-G' || (f.start_with?('-G') && f[2] != '-') }
          .join(' ')
        next if cleaned_flags == original_flags
        file.settings['COMPILER_FLAGS'] = cleaned_flags
        puts "  [Podfile] Stripped -G from BoringSSL-GRPC/#{file.file_ref&.path || 'unknown'}"
      end
    end
  end

  # ── 3. Patch gRPC-Core basic_seq.h: fix C++ template syntax for Xcode 16 ──
  #
  # ROOT CAUSE: Xcode 16's Clang enforces stricter C++17 rules and rejects
  #   Traits::template CallSeqFactory(f_, *cur_, std::move(arg));
  # because the dependent-name template call requires an explicit empty
  # template argument list <> when called with no template arguments.
  # This causes a "Parse Issue: A template argument list is expected after a
  # name prefixed by the template keyword" error on basic_seq.h:102.
  #
  # FIX: after pod install writes the source file to disk, patch it in-place
  # by adding <> after CallSeqFactory. This is idempotent — running pod install
  # again will re-download and re-patch cleanly.
  #
  # References:
  #   https://stackoverflow.com/questions/79551968
  #   https://medium.com/@abdulsamie488/solving-the-dreaded-xcode-grpc-core-build-error
  #   https://github.com/firebase/firebase-ios-sdk/issues/14643
  basic_seq_path = File.join(
    installer.sandbox.root,
    'gRPC-Core/src/core/lib/promise/detail/basic_seq.h'
  )

  if File.exist?(basic_seq_path)
    content = File.read(basic_seq_path)
    # Match the unpatched form (no <> after CallSeqFactory) and add <>
    patched = content.gsub(
      'Traits::template CallSeqFactory(f_, *cur_, std::move(arg));',
      'Traits::template CallSeqFactory<>(f_, *cur_, std::move(arg));'
    )
    if patched != content
      File.write(basic_seq_path, patched)
      puts '  [Podfile] Patched gRPC-Core basic_seq.h: added <> to CallSeqFactory'
    else
      puts '  [Podfile] gRPC-Core basic_seq.h already patched or line not found'
    end
  else
    puts "  [Podfile] WARNING: basic_seq.h not found at #{basic_seq_path}"
  end
end
