<?xml version="1.0" encoding="utf-8"?>
<!--
    HUDDL — ANDROID DATA EXTRACTION RULES (API 31+)
    Valid domains: file, database, sharedpref, external, root
    Rule: you can only <exclude> a path that was first <include>d
-->
<data-extraction-rules>

    <!-- ── CLOUD BACKUP (Google Drive) ───────────────────────────────── -->
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <!-- Include all shared preferences -->
        <include domain="sharedpref" path="." />

        <!-- Exclude transient / device-specific entries -->
        <exclude domain="sharedpref" path="ai_discovery_last_run" />
        <exclude domain="sharedpref" path="last_login_timestamp" />
        <exclude domain="sharedpref" path="data_reset_v2" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences" />
    </cloud-backup>

    <!-- ── DEVICE-TO-DEVICE TRANSFER (e.g. Quick Switch) ────────────── -->
    <device-transfer>
        <!-- Include all shared prefs for seamless device migration -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ai_discovery_last_run" />
        <exclude domain="sharedpref" path="last_login_timestamp" />
        <exclude domain="sharedpref" path="data_reset_v2" />
    </device-transfer>

</data-extraction-rules>
