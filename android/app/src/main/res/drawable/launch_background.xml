<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash: solid white matching the Flutter SplashScreen background.
     No image — the animated logo is rendered by Flutter's SplashScreen widget.
     This prevents the white-flash / wrong-colour blink on cold start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FFFFFF"/>
    </item>
</layer-list>
