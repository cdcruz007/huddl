<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ────────────────────────────────────────────────────────
         INTERNET        : Required for Firebase, backend API calls, and Stripe.
         BILLING         : Required by Google Play Billing / in_app_purchase.
                           Without this the purchase sheet will not open and
                           InAppPurchase.instance.isAvailable() returns false.
    ──────────────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="com.android.vending.BILLING"/>
    <!-- POST_NOTIFICATIONS: Required on Android 13+ (API 33+) for FCM push
         notification permission prompt. Without this the system blocks the
         requestPermission() call and no push notifications are delivered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- USE_BIOMETRIC: Required by local_auth on Android API 28+ for fingerprint/face/iris
         authentication. Without this permission, authenticate() returns false silently on
         all Android devices. iOS does not require a manifest declaration. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- USE_FINGERPRINT: Required for backward compatibility with Android API < 28.
         local_auth falls back to this permission on older devices. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <!-- RECORD_AUDIO: Required for voice message recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- READ/WRITE external storage for saving voice recordings (API < 29) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- CAMERA: Required for taking photos and videos in chat -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- READ_MEDIA_IMAGES / READ_MEDIA_VIDEO: Required on Android 13+ (API 33+) for gallery
         access. READ_EXTERNAL_STORAGE is ignored on API 33+; these granular permissions
         replace it. image_picker and file_picker both require these on modern Android. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <!-- READ_MEDIA_VISUAL_USER_SELECTED: Android 14+ partial photo library access.
         Allows users to grant access to a subset of photos rather than all of them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- READ_CONTACTS: Required for the Contact sharing feature in chat -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- LOCATION: Required for sharing location in chat messages -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="Huddl"
        android:name="androidx.multidex.MultiDexApplication"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:backupAgent=".HuddlBackupAgent"
        android:backupInForeground="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FileProvider: Required by image_picker on Android 7+ (API 24+) to share
             camera-captured image URIs via content:// scheme. Without this, taking
             a photo crashes with FileUriExposedException on Android 7+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.flutter.image_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- FileProvider: Required by image_cropper v8+ on Android to pass the
             cropped image URI back to the app via content:// scheme.
             image_cropper uses a separate authority from image_picker to avoid
             conflicts. Without this entry, image_cropper crashes on Android
             with "Failed to find configured root" or IllegalArgumentException. -->
        <provider
            android:name="com.yalantis.ucrop.UCropFileProvider"
            android:authorities="${applicationId}.image_cropper.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ── FCM default notification channel ────────────────────────────────
             Sets the default channel for FCM messages that do not specify a
             channel_id in their payload.  Must match one of the channel IDs
             created programmatically in MainActivity.createHuddlNotificationChannels().
             Without this, FCM falls back to a generic "Miscellaneous" channel.
        ──────────────────────────────────────────────────────────────────── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="huddl_system_alerts" />

        <!-- Notification icon: a small monochrome icon shown in the status bar.
             FCM requires a small icon that works on all Android API levels.
             Using the existing launcher icon as fallback. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Notification accent colour: brand orange shown behind the notification icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- ── Firebase Test Lab compatibility fix ────────────────────────────
             androidx.profileinstaller is pulled in as a transitive dependency
             and auto-merges ProfileInstallReceiver into our manifest.  That
             receiver declares android:permission="android.permission.DUMP",
             which is a system-only permission.  Firebase Test Lab sees it and
             immediately rejects the run with "Test failed to run" before a
             single Robo step fires.

             tools:node="remove" strips it from the merged manifest at build
             time.  The receiver is only needed for Baseline Profiles
             (performance optimisation for Play Store) — removing it has zero
             effect on app behaviour or Firebase functionality.
        ──────────────────────────────────────────────────────────────────── -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- ── Google Play Billing visibility (Android 11+) ──────────────────
             Allows in_app_purchase to detect and communicate with the Play
             Store billing service. Required on API 30+ due to package
             visibility restrictions (PMS queries).
        ──────────────────────────────────────────────────────────────────── -->
        <package android:name="com.android.vending"/>
    </queries>
</manifest>








