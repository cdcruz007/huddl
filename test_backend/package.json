{
  "name": "huddl-backend-tests",
  "version": "1.0.0",
  "description": "Huddl backend integration + security-rules tests",
  "scripts": {
    "test": "jest --testPathPattern='.*\\.test\\.(js|ts)$' --forceExit --runInBand",
    "test:rules": "jest --testPathPattern='rules\\.test' --forceExit --runInBand",
    "test:integration": "jest --testPathPattern='integration\\.test' --forceExit --runInBand",
    "test:live-ai": "LIVE_AI=true jest --testPathPattern='ai\\.live\\.test' --forceExit --runInBand"
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.0.0",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.0.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "esModuleInterop": true,
          "module": "commonjs",
          "target": "es2020",
          "strict": false
        }
      }
    }
  }
}
