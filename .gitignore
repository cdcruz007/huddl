# ── iOS CocoaPods ────────────────────────────────────────────────────────────
# Podfile.lock MUST be committed so everyone resolves the exact same pod
# versions (especially Firebase iOS SDK 10.27.0 — see ios/Podfile comment).
# The Pods/ directory itself is NOT committed (regenerated by pod install).
!ios/Podfile.lock
ios/Pods/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend secrets (NEVER commit)
backend/.env
backend/config/firebase-admin-sdk.json
backend/config/apple-subscription-key.p8
backend/node_modules/

# Signing keys
android/release-key.jks
android/key.properties
.env
*firebase-adminsdk*.json
*-adminsdk-*.json
