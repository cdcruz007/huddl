rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// HUDDL — FIREBASE STORAGE SECURITY RULES
// Project: huddl-connect  •  Bucket: huddl-connect.firebasestorage.app
// ═══════════════════════════════════════════════════════════════════════════
//
// Principle: every path is explicitly allowed or denied.
// Default deny is automatic in rules_version = '2'.
//
// All URLs served to clients are getDownloadURL() signed tokens — no path
// needs to be world-readable.  Every read rule therefore requires auth.
//
// Upload size limits are enforced per path to prevent abuse:
//   • Photos / images : 10 MB  (request.resource.size <= 10 * 1024 * 1024)
//   • Voice notes     : 25 MB  (audio files can be longer recordings)
//   • Documents       : 20 MB  (PDFs, Word docs attached in group chat)
//
// Content-type guards prevent uploading an executable disguised as an image.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    /// Caller is signed in.
    function isAuth() {
      return request.auth != null;
    }

    /// Caller's UID matches the uid segment in the path.
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /// File is an image (jpeg, png, gif, webp).
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    /// File is audio (any subtype — covers mp4/aac/webm voice notes).
    function isAudio() {
      return request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'video/webm';  // webm recorded on web
    }

    /// File is a document.
    /// Covers exactly the types MediaAttachService._getMimeType() emits for the
    /// allowed extensions: pdf, doc/docx, xls/xlsx, ppt/pptx, txt, csv, zip, rar.
    /// S-03 audit: dropped text/.* (too broad — would allow text/html, text/js);
    /// replaced with explicit text/plain + text/csv only.
    /// Added spreadsheet, presentation, zip/rar types that were missing.
    /// application/octet-stream intentionally excluded: unknown extensions are
    /// denied at the Storage rule level (picker is constrained to known exts).
    function isDocument() {
      return request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/.*msword.*')
          || request.resource.contentType.matches('application/vnd[.]openxmlformats.*wordprocessingml.*')
          || request.resource.contentType.matches('application/vnd[.]ms-excel.*')
          || request.resource.contentType.matches('application/vnd[.]openxmlformats.*spreadsheetml.*')
          || request.resource.contentType.matches('application/vnd[.]ms-powerpoint.*')
          || request.resource.contentType.matches('application/vnd[.]openxmlformats.*presentationml.*')
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'text/csv'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType.matches('application/x-zip.*')
          || request.resource.contentType.matches('application/x-rar.*');
    }

    /// Max file size in bytes.
    function maxSize(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // =========================================================================
    // PROFILE PHOTOS
    // Path: profile_photos/{uid}/{filename}
    // =========================================================================
    // Written by PhotoUploadService.uploadProfilePhoto() and
    // PhotoUploadService.uploadProfilePhotoFromFile().
    // Only the owning user may upload/overwrite their own photo.
    // Any authenticated user may read (needed for group member avatars,
    // DM header, event attendee lists, etc.).
    // =========================================================================
    match /profile_photos/{uid}/{fileName} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid)
                    && isImage()
                    && maxSize(10);
    }

    // =========================================================================
    // MARKETPLACE LISTING IMAGES
    // Path: marketplace_images/{uid}/{filename}
    // =========================================================================
    // Written by create_listing_screen._uploadPendingImages().
    // The sellerId in the Firestore marketplace doc matches the uid segment.
    // Any authenticated user may read (needed to display listings).
    // =========================================================================
    match /marketplace_images/{uid}/{fileName} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid)
                    && isImage()
                    && maxSize(10);
    }

    // =========================================================================
    // VOICE NOTES
    // Path: voice_notes/{conversationId}/{filename}
    //    or voice_notes/{uid}/{filename}   (fallback when no conversationId)
    // =========================================================================
    // Written by VoiceMessageService.uploadVoiceNote().
    // The filename contains the sender UID: {uid}_{timestamp}.{ext}
    // We cannot enforce ownership purely on the path segment (conversationId
    // is the second segment for DMs), so we require auth + audio content type.
    // File name convention enforced by the service — not repeated here.
    // Any participant who can read the message in Firestore gets the URL via
    // getDownloadURL(), so reads are auth-gated.
    // =========================================================================
    // DM VOICE NOTES
    // Path: voice_notes/dm/{conversationId}/{uid}_{timestamp}.{ext}
    // =========================================================================
    // Written by VoiceMessageService.uploadVoiceNote() with pathType=dm.
    // S-04 fix: scoped to DM conversation participants via firestore.get().
    // Previously: voice_notes/{segment}/{file} — any auth user could read or
    // write any conversation's voice notes without being a participant.
    // The old flat path voice_notes/{segment}/{file} is REMOVED; any write to
    // the old structure is denied by the catch-all match /{allPaths=**}.
    // =========================================================================
    match /voice_notes/dm/{conversationId}/{fileName} {
      allow read:  if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow write: if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants
                   && isAudio()
                   && maxSize(25);
    }

    // =========================================================================
    // GROUP VOICE NOTES
    // Path: voice_notes/group/{groupId}/{uid}_{timestamp}.{ext}
    // =========================================================================
    // Written by VoiceMessageService.uploadVoiceNote() with pathType=group.
    // S-04 fix: scoped to group members via firestore.get() memberIds check.
    // =========================================================================
    match /voice_notes/group/{groupId}/{fileName} {
      allow read:  if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow write: if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
                   && isAudio()
                   && maxSize(25);
    }

    // =========================================================================
    // DM IMAGE ATTACHMENTS
    // Path: dm_images/{conversationId}/{uid}_{timestamp}.{ext}
    // =========================================================================
    // Written by dm_chat_screen._uploadMediaToStorage() with folder='dm_images'.
    // S-01 fix: conversationId is now a path segment — rule gates on
    // conversations/{cid}.participants membership via firestore.get().
    // Previously: dm_images/{file} — any auth user could read/write any DM
    // image without being a participant in the conversation.
    // The old flat path dm_images/{file} is REMOVED; writes to the old
    // structure are denied by the catch-all match /{allPaths=**}.
    // =========================================================================
    match /dm_images/{conversationId}/{fileName} {
      allow read:  if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow write: if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants
                   && (isImage() || isDocument())
                   && maxSize(20);
    }

    // =========================================================================
    // DM DOCUMENT ATTACHMENTS
    // Path: dm_documents/{conversationId}/{uid}_{timestamp}.{ext}
    // =========================================================================
    // Written by dm_chat_screen._uploadMediaToStorage() with folder='dm_documents'.
    // S-02 fix: same participant-scoping pattern as dm_images.
    // The old flat path dm_documents/{file} is REMOVED; denied by catch-all.
    // =========================================================================
    match /dm_documents/{conversationId}/{fileName} {
      allow read:  if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow write: if isAuth()
                   && request.auth.uid in
                       firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants
                   && (isImage() || isDocument())
                   && maxSize(20);
    }

    // =========================================================================
    // GROUP CHAT IMAGES
    // Path: group_images/{groupId}/{uid}_{timestamp}.jpg
    // =========================================================================
    // Written by group_chat_screen._uploadImageAttachment() and
    // thread_reply_screen image upload.
    // S-03 fix: scoped to group members via firestore.get() memberIds check.
    // Previously: allow read/write if isAuth() — any auth user could read or
    // write any group's images without being a member.
    // =========================================================================
    match /group_images/{groupId}/{fileName} {
      allow read:   if isAuth()
                    && request.auth.uid in
                        firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow write:  if isAuth()
                    && request.auth.uid in
                        firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
                    && isImage()
                    && maxSize(10);
    }

    // =========================================================================
    // GROUP CHAT DOCUMENTS
    // Path: group_documents/{groupId}/{uid}_{timestamp}.{ext}
    // =========================================================================
    // Written by group_chat_screen._uploadDocumentAttachment().
    // S-03 fix: scoped to group members via firestore.get() memberIds check.
    // Previously: allow read/write if isAuth() — any auth user could read or
    // write any group's documents without being a member.
    // =========================================================================
    match /group_documents/{groupId}/{fileName} {
      allow read:   if isAuth()
                    && request.auth.uid in
                        firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow write:  if isAuth()
                    && request.auth.uid in
                        firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
                    && (isImage() || isDocument())
                    && maxSize(20);
    }

    // =========================================================================
    // CATCH-ALL: deny everything not explicitly listed above.
    // This is implicit in rules_version = '2' but stated explicitly for clarity.
    // =========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
