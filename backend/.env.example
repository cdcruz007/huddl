# ═══════════════════════════════════════════════════════════════════════════════
# HUDDL CONNECT BACKEND — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to your Firebase Admin SDK JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-admin-sdk.json
FIREBASE_PROJECT_ID=huddl-connect

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs — create in Stripe Dashboard > Products
STRIPE_PRICE_NEIGHBOURHOOD_MONTHLY=price_neighbourhood_monthly
STRIPE_PRICE_NEIGHBOURHOOD_ANNUAL=price_neighbourhood_annual
STRIPE_PRICE_NEIGHBOURHOOD_FOUNDING=price_neighbourhood_founding
STRIPE_PRICE_INNER_CIRCLE_MONTHLY=price_inner_circle_monthly
STRIPE_PRICE_INNER_CIRCLE_ANNUAL=price_inner_circle_annual

# ── Apple App Store ───────────────────────────────────────────────────────────
# App Store Connect > Users and Access > Keys
APPLE_SHARED_SECRET=YOUR_APP_STORE_SHARED_SECRET
APPLE_BUNDLE_ID=com.huddlconnect.huddlConnect
# For App Store Server API v2 (preferred over deprecated verifyReceipt)
APPLE_ISSUER_ID=YOUR_APPLE_ISSUER_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=./config/apple-subscription-key.p8

# ── Google Play ───────────────────────────────────────────────────────────────
# Uses the same Firebase service account (must have Play Developer API access)
GOOGLE_PLAY_PACKAGE_NAME=com.huddlconnect.huddl_connect

# ── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=hello@huddlconnect.com
SENDGRID_FROM_NAME=Huddl Connect

# ── Twilio (SMS — optional, phone auth handled by Firebase) ──────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+447XXX

# ── JWT (for API auth tokens) ────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=7d

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://huddlconnect.com
STRIPE_SUCCESS_URL=https://huddlconnect.com/subscription/success
STRIPE_CANCEL_URL=https://huddlconnect.com/subscription/cancel
