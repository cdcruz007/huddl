# ===============================================================================
# HUDDL CONNECT BACKEND -- ENVIRONMENT CONFIGURATION
# ===============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# -- Server --------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -- Firebase ------------------------------------------------------------------
# On Railway/cloud: use FIREBASE_SERVICE_ACCOUNT_JSON (base64-encoded JSON).
# Locally: use FIREBASE_SERVICE_ACCOUNT_PATH pointing to the .json file.
# Generate base64 value: base64 -i config/firebase-admin-sdk.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=<base64_encoded_service_account_json>
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-admin-sdk.json
FIREBASE_PROJECT_ID=huddl-connect

# -- Stripe --------------------------------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs -- names must match stripe-service.js PRICE_MAP exactly
# Get price_xxx IDs from https://dashboard.stripe.com/products
STRIPE_PRICE_NEIGHBOUR_MONTHLY=price_1TPMiQGb8Lg9FVI5hzdkzA23
STRIPE_PRICE_NEIGHBOUR_ANNUAL=price_1TPMjBGb8Lg9FVI5zZwvMgVe
STRIPE_PRICE_CIRCLE_MONTHLY=price_1TPUqjGb8Lg9FVI5uk3rAKlJ
STRIPE_PRICE_CIRCLE_ANNUAL=price_1TPMl5Gb8Lg9FVI5YKuJNSRL

# -- Apple App Store -----------------------------------------------------------
# App Store Connect > Users and Access > Keys > In-App Purchase
APPLE_SHARED_SECRET=YOUR_APP_STORE_SHARED_SECRET
APPLE_BUNDLE_ID=com.huddlconnect.huddlConnect
APPLE_ISSUER_ID=YOUR_APPLE_ISSUER_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# On Railway/cloud: paste the FULL .p8 file contents as a single line.
# Include header + footer. Use \n for newlines in the Railway UI value field.
# Example: "-----BEGIN PRIVATE KEY-----\nMIGHAgEA...rest...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=YOUR_FULL_P8_KEY_CONTENTS_WITH_ESCAPED_NEWLINES
# Local dev only (ignored if APPLE_PRIVATE_KEY is set):
APPLE_PRIVATE_KEY_PATH=./config/apple-subscription-key.p8

# -- Google Play ---------------------------------------------------------------
# Must match applicationId in android/app/build.gradle.kts
GOOGLE_PLAY_PACKAGE_NAME=com.huddlconnect.connect

# -- Email: Hostinger SMTP -----------------------------------------------------
# Hostinger panel: Emails -> Manage -> SMTP settings
# Host: smtp.hostinger.com  |  Port: 465 (SSL) or 587 (TLS/STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=welcome@huddlapp.co.uk
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD

# -- JWT -----------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=7d

# -- Cron job authentication ---------------------------------------------------
# Shared secret sent as X-Cron-Secret header for the trial-reminders endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# -- Frontend URLs -------------------------------------------------------------
FRONTEND_URL=https://www.huddlapp.co.uk
STRIPE_SUCCESS_URL=https://www.huddlapp.co.uk/subscription/success
STRIPE_CANCEL_URL=https://www.huddlapp.co.uk/subscription/cancel
